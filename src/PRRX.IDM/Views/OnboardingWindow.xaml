<ui:FluentWindow x:Class="PRRX.IDM.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:PRRX.IDM.Converters"
        mc:Ignorable="d"
        Title="Welcome to PRRX Internet Download Manager" 
        Icon="/Assets/app_icon.png"
        Height="640" Width="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <converters:EqualityToVisibilityConverter x:Key="EqToVis"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:FactorToPercentageConverter x:Key="FactorToPercent"/>
    </ui:FluentWindow.Resources>

    <Grid Margin="32,22,32,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar / Header Progress -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="PRRX Internet Download Manager" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Initial Quick Setup &amp; Browser Integration Tutorial" Opacity="0.7" FontSize="13"/>
            </StackPanel>

            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.8">
                <Run Text="Step "/>
                <Run Text="{Binding CurrentStep, Mode=OneWay}"/>
                <Run Text=" of "/>
                <Run Text="{Binding TotalSteps, Mode=OneWay}"/>
            </TextBlock>
        </Grid>

        <!-- Step Content Area -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                CornerRadius="10" Padding="26" Margin="0,0,0,18"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <!-- STEP 1: Welcome -->
                <StackPanel VerticalAlignment="Center" Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=1}">
                    <Border Width="64" Height="64" CornerRadius="14" Margin="0,0,0,14" HorizontalAlignment="Center" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/app_icon.png" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Welcome to PRRX Internet Download Manager" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="Experience ultra-fast 32-stream multi-socket downloads, pristine 320 kbps MP3 audio extraction, and HD YouTube thumbnail captures — all wrapped in Windows 11 Fluent design." 
                               Opacity="0.8" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" LineHeight="20"/>
                    
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" Margin="20,16,20,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="⚡ 32 Streams" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Turbo Acceleration" FontSize="11" Opacity="0.7" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="🌐 Universal Grabber" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#107C41"/>
                                <TextBlock Text="Chrome &amp; Edge Integrated" FontSize="11" Opacity="0.7" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="📉 ~20 MB RAM" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#8764B8"/>
                                <TextBlock Text="Kernel Working Set Trim" FontSize="11" Opacity="0.7" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="PRRX Cooperation • Built for maximum speed, privacy &amp; zero bloat" 
                               Opacity="0.5" FontSize="11" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>

                <!-- STEP 2: Theme Setup -->
                <StackPanel VerticalAlignment="Center" Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=2}">
                    <TextBlock Text="Choose Your Preferred Theme" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="Select how PRRX IDM looks. The application automatically coordinates with your Windows style." 
                               Opacity="0.7" FontSize="13" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                        <ui:Button Content="System Theme" Icon="{ui:SymbolIcon Symbol=Laptop24}"
                                   Command="{Binding SetThemeCommand}" CommandParameter="System"
                                   Height="60" Width="170" Margin="0,0,12,0"/>

                        <ui:Button Content="Light Mode" Icon="{ui:SymbolIcon Symbol=WeatherSunny24}"
                                   Command="{Binding SetThemeCommand}" CommandParameter="Light"
                                   Height="60" Width="170" Margin="0,0,12,0"/>

                        <ui:Button Content="Dark Mode" Icon="{ui:SymbolIcon Symbol=WeatherMoon24}"
                                   Command="{Binding SetThemeCommand}" CommandParameter="Dark"
                                   Height="60" Width="170"/>
                    </StackPanel>
                </StackPanel>

                <!-- STEP 3: Transparency Slider -->
                <StackPanel VerticalAlignment="Center" Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=3}">
                    <TextBlock Text="Windows 11 Transparency &amp; Blur" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="Tune the dynamic Mica/Acrylic glass opacity to your aesthetic preference." 
                               Opacity="0.7" FontSize="13" Margin="0,0,0,20"/>

                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Backdrop Transparency Factor" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding TransparencyFactor, Converter={StaticResource FactorToPercent}}" 
                                           FontWeight="Bold" FontSize="15"/>
                            </Grid>

                            <Slider Minimum="0.20" Maximum="1.0" Value="{Binding TransparencyFactor, Mode=TwoWay}"
                                    IsEnabled="{Binding IsWin11}" SmallChange="0.05" LargeChange="0.1" Margin="0,6,0,0"/>

                            <TextBlock Text="* Note: Live dynamic transparency slider is active on Windows 11 systems." 
                                       FontSize="11" Foreground="#FF8C00" Margin="0,10,0,0"
                                       Visibility="{Binding IsWin11, Converter={StaticResource InvBoolToVis}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- STEP 4: Browser Extension & Website Integration Tutorial -->
                <Grid Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=4}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Browser Extension &amp; Website Integration Tutorial" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Step-by-step guidance to capture video links, download buttons, and streaming media across all websites." 
                                   Opacity="0.7" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Interactive Guide Sub-Tabs -->
                    <Border Grid.Row="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sub-Tab 1: Auto-Integration -->
                            <Grid Grid.Column="0" Margin="2,0">
                                <ui:Button Content="1. Auto-Integration" Icon="{ui:SymbolIcon Symbol=CheckmarkCircle24}"
                                           Appearance="Primary" HorizontalAlignment="Stretch" Height="36"
                                           Visibility="{Binding ExtensionSubStep, Converter={StaticResource EqToVis}, ConverterParameter=1}"/>
                                <ui:Button Content="1. Auto-Integration" Icon="{ui:SymbolIcon Symbol=CheckmarkCircle24}"
                                           Appearance="Secondary" HorizontalAlignment="Stretch" Height="36"
                                           Command="{Binding SetExtensionSubStepCommand}" CommandParameter="1"
                                           Visibility="{Binding ExtensionSubStep, Converter={StaticResource EqToVis}, ConverterParameter=not-1}"/>
                            </Grid>

                            <!-- Sub-Tab 2: Video Grabber & Sites -->
                            <Grid Grid.Column="1" Margin="2,0">
                                <ui:Button Content="2. Video Grabber &amp; Sites" Icon="{ui:SymbolIcon Symbol=Video24}"
                                           Appearance="Primary" HorizontalAlignment="Stretch" Height="36"
                                           Visibility="{Binding ExtensionSubStep, Converter={StaticResource EqToVis}, ConverterParameter=2}"/>
                                <ui:Button Content="2. Video Grabber &amp; Sites" Icon="{ui:SymbolIcon Symbol=Video24}"
                                           Appearance="Secondary" HorizontalAlignment="Stretch" Height="36"
                                           Command="{Binding SetExtensionSubStepCommand}" CommandParameter="2"
                                           Visibility="{Binding ExtensionSubStep, Converter={StaticResource EqToVis}, ConverterParameter=not-2}"/>
                            </Grid>

                            <!-- Sub-Tab 3: Load Unpacked & Pin -->
                            <Grid Grid.Column="2" Margin="2,0">
                                <ui:Button Content="3. Load Unpacked &amp; Pin" Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                           Appearance="Primary" HorizontalAlignment="Stretch" Height="36"
                                           Visibility="{Binding ExtensionSubStep, Converter={StaticResource EqToVis}, ConverterParameter=3}"/>
                                <ui:Button Content="3. Load Unpacked &amp; Pin" Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                           Appearance="Secondary" HorizontalAlignment="Stretch" Height="36"
                                           Command="{Binding SetExtensionSubStepCommand}" CommandParameter="3"
                                           Visibility="{Binding ExtensionSubStep, Converter={StaticResource EqToVis}, ConverterParameter=not-3}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Sub-Step Views Area -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <!-- Sub-Step 1: Automated Chrome & Edge Integration -->
                            <StackPanel Visibility="{Binding ExtensionSubStep, Converter={StaticResource EqToVis}, ConverterParameter=1}">
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="⚡ Automatic Chrome &amp; Microsoft Edge Integration" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="PRRX IDM automatically registers its Native Messaging Host (com.prrx.idm) and extension registry keys directly in Windows. When you open Chrome or Edge, the browser connects to the PRRX IDM local acceleration engine." 
                                                   FontSize="12" Opacity="0.85" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="12" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="🔄 Local Loopback IPC Bridge" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>
                                            <TextBlock Text="High-speed named pipe &amp; 127.0.0.1:46543 bridge for instant zero-latency link interception." FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="12" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="🛡️ Clean Native Uninstaller" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>
                                            <TextBlock Text="Clean Windows uninstallation automatically purges host and extension registry keys with 0 residue." FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="#15107C41" BorderBrush="#30107C41" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ExtensionRegistrationStatus}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="#107C41" TextWrapping="Wrap"/>
                                        <ui:Button Grid.Column="1" Content="Verify / Re-Register Now" Icon="{ui:SymbolIcon Symbol=CheckmarkCircle24}"
                                                   Command="{Binding RegisterExtensionCommand}" Height="32" Margin="8,0,0,0"/>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,4,0,0">
                                    <ui:Button Content="Continue to Video Grabber Guide ➔" Appearance="Primary"
                                               Command="{Binding NextExtensionSubStepCommand}" HorizontalAlignment="Right" Height="34" Padding="16,0"/>
                                </Grid>
                            </StackPanel>

                            <!-- Sub-Step 2: Website Access & Floating Video Grabber -->
                            <StackPanel Visibility="{Binding ExtensionSubStep, Converter={StaticResource EqToVis}, ConverterParameter=2}">
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="🎬 Floating Video Grabber on YouTube, Vimeo, TikTok &amp; 1,000+ Sites" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="Whenever you play an HTML5 video or stream, PRRX IDM injects a floating 'Download with PRRX' button directly over the video player with resolution choices." 
                                                   FontSize="12" Opacity="0.85" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Step A: Ensure 'Site Access' is Set to 'On All Sites'" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="In Chrome or Edge, right-click the PRRX IDM extension icon -> choose 'This Can Read and Change Site Data' -> ensure 'On all sites' is checked so the floating grabber can detect videos." 
                                                   FontSize="11" Opacity="0.85" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Step B: One-Click Quality Selection (1080p, 720p, 480p, MP3)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="Click the floating blue 'Download with PRRX' button to select 1080p Full HD, 720p HD, or Audio MP3. It instantly transfers to the desktop app." 
                                                   FontSize="11" Opacity="0.85" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#0078D4" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="White" Margin="0,0,4,0"/>
                                                <TextBlock Text="Download with PRRX" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="◀ Floating grabber button appears above video players on YouTube, Vimeo, TikTok, etc." FontSize="11" Opacity="0.85" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Step C: Automatic Download Interception" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="Standard browser file downloads (.zip, .iso, .exe, .mp4) are seamlessly intercepted and accelerated with up to 32 parallel socket connections." 
                                                   FontSize="11" Opacity="0.85" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Grid.Column="0" Content="⬅ Previous: Auto-Integration" Appearance="Secondary"
                                               Command="{Binding PreviousExtensionSubStepCommand}" Height="34" Padding="14,0"/>
                                    <ui:Button Grid.Column="2" Content="Continue to Load Unpacked &amp; Pinning ➔" Appearance="Primary"
                                               Command="{Binding NextExtensionSubStepCommand}" Height="34" Padding="16,0"/>
                                </Grid>
                            </StackPanel>

                            <!-- Sub-Step 3: Manual &quot;Load Unpacked&quot; &amp; Toolbar Pinning -->
                            <StackPanel Visibility="{Binding ExtensionSubStep, Converter={StaticResource EqToVis}, ConverterParameter=3}">
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="🛠️ Manual Installation (Brave / Vivaldi / Chromium) &amp; Pinning" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="If your browser requires manual loading, follow these 4 quick steps to install and pin the PRRX extension:" 
                                                   FontSize="12" Opacity="0.85" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="10" Margin="0,0,4,4">
                                        <StackPanel>
                                            <TextBlock Text="1️⃣ Open Extensions Page" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="In Chrome, Edge, or Brave, open the Extensions page (chrome://extensions or edge://extensions)." FontSize="11" Opacity="0.8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="10" Margin="4,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="2️⃣ Enable Developer Mode" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="Turn ON the 'Developer mode' toggle switch in the top-right corner of the extensions page." FontSize="11" Opacity="0.8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="10" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="3️⃣ Click 'Load Unpacked'" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="Click the 'Load unpacked' button and select the PRRX extension folder using the button below." FontSize="11" Opacity="0.8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="10" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="4️⃣ Pin Extension to Toolbar" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="Click the puzzle icon on your browser toolbar, find PRRX IDM, and click the Pin icon for 1-click access." FontSize="11" Opacity="0.8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="#100078D4" BorderBrush="#300078D4" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                                    <TextBlock Text="💡 Tip: Clicking 'Open Extension Folder' automatically copies the folder path to your clipboard for easy pasting into your browser's file picker." FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                </Border>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,8">
                                    <ui:Button Content="Open Extension Folder" Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                               Command="{Binding OpenExtensionFolderCommand}" Appearance="Primary" Height="34" Margin="0,0,8,0"/>
                                    <ui:Button Content="Chrome Extensions" Icon="{ui:SymbolIcon Symbol=Globe24}"
                                               Command="{Binding OpenChromeExtensionsCommand}" Height="34" Margin="0,0,8,0"/>
                                    <ui:Button Content="Edge Extensions" Icon="{ui:SymbolIcon Symbol=Globe24}"
                                               Command="{Binding OpenEdgeExtensionsCommand}" Height="34"/>
                                </StackPanel>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Grid.Column="0" Content="⬅ Previous: Video Grabber &amp; Sites" Appearance="Secondary"
                                               Command="{Binding PreviousExtensionSubStepCommand}" Height="34" Padding="14,0"/>
                                    <ui:Button Grid.Column="2" Content="Next Step: Download Path ➔" Appearance="Primary"
                                               Command="{Binding NextStepCommand}" Height="34" Padding="16,0"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- STEP 5: Download Path & Completion -->
                <StackPanel VerticalAlignment="Center" Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=5}">
                    <TextBlock Text="Set Download Directory" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="Where would you like PRRX IDM to store your downloaded media and files?" 
                               Opacity="0.7" FontSize="13" Margin="0,0,0,20"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Text="{Binding DownloadDirectory, Mode=TwoWay}" Height="42" Margin="0,0,10,0"/>
                        <ui:Button Grid.Column="1" Content="Browse" Icon="{ui:SymbolIcon Symbol=FolderSearch24}" 
                                   Command="{Binding BrowseFolderCommand}" Height="42"/>
                    </Grid>

                    <Border Background="#15107C41" BorderBrush="#30107C41" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#107C41" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="You're all set! Click 'Get Started' to launch PRRX Internet Download Manager." 
                                       Foreground="#107C41" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0" Content="Back" Icon="{ui:SymbolIcon Symbol=ArrowLeft24}"
                       Command="{Binding PreviousStepCommand}"
                       Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=not-1}"
                       Height="40" Padding="20,0"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button Content="Next" Icon="{ui:SymbolIcon Symbol=ArrowRight24}" Appearance="Primary"
                           Command="{Binding NextStepCommand}"
                           Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=not-5}"
                           Height="40" Padding="24,0"/>

                <ui:Button Content="Get Started" Icon="{ui:SymbolIcon Symbol=Checkmark24}" Appearance="Primary"
                           Command="{Binding FinishCommand}"
                           Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=5}"
                           Height="40" Padding="24,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>

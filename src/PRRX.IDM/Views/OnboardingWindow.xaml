<ui:FluentWindow x:Class="PRRX.IDM.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:PRRX.IDM.Converters"
        mc:Ignorable="d"
        Title="Welcome to PRRX Internet Download Manager" 
        Icon="/Assets/app_icon.png"
        Height="540" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <converters:EqualityToVisibilityConverter x:Key="EqToVis"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:FactorToPercentageConverter x:Key="FactorToPercent"/>
    </ui:FluentWindow.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar / Header Progress -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="PRRX Internet Download Manager" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Initial Quick Setup &amp; Personalization" Opacity="0.7" FontSize="13"/>
            </StackPanel>

            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.8">
                <Run Text="Step "/>
                <Run Text="{Binding CurrentStep, Mode=OneWay}"/>
                <Run Text=" of 4"/>
            </TextBlock>
        </Grid>

        <!-- Step Content Area -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                CornerRadius="10" Padding="28" Margin="0,0,0,24"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <!-- STEP 1: Welcome -->
                <StackPanel VerticalAlignment="Center" Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=1}">
                    <ui:SymbolIcon Symbol="ArrowDownload48" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Welcome to PRRX Internet Download Manager" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="Experience ultra-fast video downloads, pristine MP3 audio extraction, and HD YouTube thumbnail captures — all with native Windows 11 Fluent design." 
                               Opacity="0.8" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" LineHeight="20"/>
                    <TextBlock Text="PRRX Cooperation • Built for maximum speed &amp; privacy" 
                               Opacity="0.5" FontSize="11" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>

                <!-- STEP 2: Theme Setup -->
                <StackPanel VerticalAlignment="Center" Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=2}">
                    <TextBlock Text="Choose Your Preferred Theme" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="Select how PRRX IDM looks. The application automatically coordinates with your Windows style." 
                               Opacity="0.7" FontSize="13" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                        <ui:Button Content="System Theme" Icon="{ui:SymbolIcon Symbol=Laptop24}"
                                   Command="{Binding SetThemeCommand}" CommandParameter="System"
                                   Height="60" Width="170" Margin="0,0,12,0"/>

                        <ui:Button Content="Light Mode" Icon="{ui:SymbolIcon Symbol=WeatherSunny24}"
                                   Command="{Binding SetThemeCommand}" CommandParameter="Light"
                                   Height="60" Width="170" Margin="0,0,12,0"/>

                        <ui:Button Content="Dark Mode" Icon="{ui:SymbolIcon Symbol=WeatherMoon24}"
                                   Command="{Binding SetThemeCommand}" CommandParameter="Dark"
                                   Height="60" Width="170"/>
                    </StackPanel>
                </StackPanel>

                <!-- STEP 3: Transparency Slider -->
                <StackPanel VerticalAlignment="Center" Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=3}">
                    <TextBlock Text="Windows 11 Transparency &amp; Blur" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="Tune the dynamic Mica/Acrylic glass opacity to your aesthetic preference." 
                               Opacity="0.7" FontSize="13" Margin="0,0,0,20"/>

                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Backdrop Transparency Factor" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding TransparencyFactor, Converter={StaticResource FactorToPercent}}" 
                                           FontWeight="Bold" FontSize="15"/>
                            </Grid>

                            <Slider Minimum="0.20" Maximum="1.0" Value="{Binding TransparencyFactor, Mode=TwoWay}"
                                    IsEnabled="{Binding IsWin11}" SmallChange="0.05" LargeChange="0.1" Margin="0,6,0,0"/>

                            <TextBlock Text="* Note: Live dynamic transparency slider is active on Windows 11 systems." 
                                       FontSize="11" Foreground="#FF8C00" Margin="0,10,0,0"
                                       Visibility="{Binding IsWin11, Converter={StaticResource InvBoolToVis}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- STEP 4: Download Path & Completion -->
                <StackPanel VerticalAlignment="Center" Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=4}">
                    <TextBlock Text="Set Download Directory" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="Where would you like PRRX IDM to store your downloaded media and files?" 
                               Opacity="0.7" FontSize="13" Margin="0,0,0,20"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Text="{Binding DownloadDirectory, Mode=TwoWay}" Height="42" Margin="0,0,10,0"/>
                        <ui:Button Grid.Column="1" Content="Browse" Icon="{ui:SymbolIcon Symbol=FolderSearch24}" 
                                   Command="{Binding BrowseFolderCommand}" Height="42"/>
                    </Grid>

                    <TextBlock Text="You're all set! Click 'Get Started' to launch PRRX Internet Download Manager." 
                               Foreground="#107C41" FontWeight="Medium"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0" Content="Back" Icon="{ui:SymbolIcon Symbol=ArrowLeft24}"
                       Command="{Binding PreviousStepCommand}"
                       Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=not-1}"
                       Height="40" Padding="20,0"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button Content="Next" Icon="{ui:SymbolIcon Symbol=ArrowRight24}" Appearance="Primary"
                           Command="{Binding NextStepCommand}"
                           Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=not-4}"
                           Height="40" Padding="24,0"/>

                <ui:Button Content="Get Started" Icon="{ui:SymbolIcon Symbol=Checkmark24}" Appearance="Primary"
                           Command="{Binding FinishCommand}"
                           Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=4}"
                           Height="40" Padding="24,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>

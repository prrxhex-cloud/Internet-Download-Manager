<Window x:Class="PRRX.IDM.Views.ActiveDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PRRX.IDM.Controls"
        mc:Ignorable="d"
        Title="PRRX IDM Module" 
        Height="540" Width="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/Assets/app_icon.png"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Sleek Glass Tab Control Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="#161B26" CornerRadius="6,6,0,0" Margin="0,0,4,0" Padding="14,8">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1F283A"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#8A9BB4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#253046"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vector Window Caption Control Button Styles -->
        <Style x:Key="CaptionMinimizeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="5">
                            <Path x:Name="IconPath" Data="M 0,0 L 10,0" Stroke="#8A9BB4" StrokeThickness="1.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#253046"/>
                                <Setter TargetName="IconPath" Property="Stroke" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1C2436"/>
                                <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="5">
                            <Path x:Name="IconPath" Data="M 0,0 L 9,9 M 0,9 L 9,0" Stroke="#8A9BB4" StrokeThickness="1.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#E81123"/>
                                <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#C42B1C"/>
                                <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#10141D" 
            BorderBrush="#252F42" 
            BorderThickness="1" 
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="10" Opacity="0.7"/>
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Tabs Content -->
                <RowDefinition Height="Auto"/> <!-- Global Master Progress Bar -->
                <RowDefinition Height="Auto"/> <!-- Control Buttons -->
                <RowDefinition Height="Auto"/> <!-- Expandable Details (Segment Bar & Thread Grid) -->
            </Grid.RowDefinitions>

            <!-- 1. Window Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="#1A2233" Margin="0,0,10,0" VerticalAlignment="Center" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/app_icon.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PRRX IDM Module" FontSize="14" FontWeight="Bold" Foreground="#F0F4F8" VerticalAlignment="Center"/>
                            <Border Background="#122E3B" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Turbo Stream" FontSize="10" FontWeight="SemiBold" Foreground="#00E5FF"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="#8A9BB4" Margin="0,2,0,0" 
                                   TextTrimming="CharacterEllipsis" MaxWidth="460" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,-4,0">
                    <Button Style="{StaticResource CaptionMinimizeButtonStyle}" ToolTip="Minimize" Click="Minimize_Click" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource CaptionCloseButtonStyle}" ToolTip="Close" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- 2. The 3 Main Tabs -->
            <TabControl Grid.Row="1" Margin="0,0,0,10">
                <!-- TAB 1: Download status -->
                <TabItem Header="Download status">
                    <Border Background="#151B27" BorderBrush="#242E42" BorderThickness="1" CornerRadius="0,8,8,8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Target URL -->
                            <TextBox Grid.Row="0" Text="{Binding Url, Mode=OneWay}" IsReadOnly="True"
                                     Background="#0F131C" Foreground="#7E8FA8" BorderBrush="#222B3D" BorderThickness="1"
                                     Padding="8,5" Margin="0,0,0,10" FontSize="11"/>

                            <!-- Metric Rows -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:" Foreground="#8A9BB4" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}" Foreground="#00E5FF" FontWeight="SemiBold" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="File size:" Foreground="#8A9BB4" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FileSizeFormatted}" Foreground="#E2E8F0" Margin="0,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Downloaded:" Foreground="#8A9BB4" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DownloadedFormatted}" Foreground="#F0F4F8" FontWeight="Medium" Margin="0,2"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Transfer rate:" Foreground="#8A9BB4" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TransferRateFormatted}" Foreground="#00FF88" FontWeight="Bold" Margin="0,2"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Time left:" Foreground="#8A9BB4" Margin="0,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TimeLeftFormatted}" Foreground="#E2E8F0" Margin="0,2"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Resume capability:" Foreground="#8A9BB4" Margin="0,2"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ResumeCapability}" Foreground="#00E5FF" Margin="0,2"/>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- TAB 2: Speed Limiter -->
                <TabItem Header="Speed Limiter">
                    <Border Background="#151B27" BorderBrush="#242E42" BorderThickness="1" CornerRadius="0,8,8,8" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="Active transfer rate: " Foreground="#8A9BB4" FontSize="13"/>
                                <TextBlock Text="{Binding TransferRateFormatted}" Foreground="#00FF88" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>

                            <CheckBox Content="Use Speed Limiter" IsChecked="{Binding UseSpeedLimiter, Mode=TwoWay}"
                                      Foreground="#F0F4F8" FontWeight="Medium" FontSize="13" Margin="0,0,0,16"/>

                            <TextBlock Text="Maximum download speed:" Foreground="#8A9BB4" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <Slider Grid.Column="0" Minimum="50" Maximum="20000" Value="{Binding MaxSpeedKbps, Mode=TwoWay}"
                                        IsEnabled="{Binding UseSpeedLimiter}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                <TextBox Grid.Column="1" Text="{Binding MaxSpeedKbps, UpdateSourceTrigger=PropertyChanged}" 
                                         IsEnabled="{Binding UseSpeedLimiter}"
                                         Background="#0F131C" Foreground="#00E5FF" FontWeight="SemiBold"
                                         BorderBrush="#252F42" BorderThickness="1" Padding="8,5" TextAlignment="Center"/>

                                <TextBlock Grid.Column="2" Text="KB/sec" Foreground="#8A9BB4" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>

                            <CheckBox Content="Remember Speed Limiter settings for this file" 
                                      IsChecked="{Binding RememberSpeedLimiter, Mode=TwoWay}"
                                      Foreground="#8A9BB4" FontSize="12" Margin="0,0,0,16"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- TAB 3: Options on completion -->
                <TabItem Header="Options on completion">
                    <Border Background="#151B27" BorderBrush="#242E42" BorderThickness="1" CornerRadius="0,8,8,8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Save To:" Foreground="#8A9BB4" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding DestinationFilePath, Mode=OneWay}" IsReadOnly="True"
                                     Background="#0F131C" Foreground="#A0AEC0" BorderBrush="#222B3D" BorderThickness="1"
                                     Padding="8,5" Margin="0,0,0,14" FontSize="11"/>

                            <CheckBox Content="Show download complete dialog" IsChecked="{Binding ShowCompleteDialog, Mode=TwoWay}"
                                      Foreground="#F0F4F8" Margin="0,0,0,10"/>

                            <CheckBox Content="Exit PRRX Internet Download Manager when done" IsChecked="{Binding ExitWhenDone, Mode=TwoWay}"
                                      Foreground="#F0F4F8" Margin="0,0,0,10"/>

                            <CheckBox Content="Turn off computer when done" IsChecked="{Binding ShutdownWhenDone, Mode=TwoWay}"
                                      Foreground="#F0F4F8" Margin="0,0,0,8"/>

                            <!-- Action dropdown (Shutdown, Sleep, Restart) -->
                            <StackPanel Orientation="Horizontal" Margin="24,0,0,10" IsEnabled="{Binding ShutdownWhenDone}">
                                <TextBlock Text="Action:" Foreground="#8A9BB4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding AvailableShutdownActions}" SelectedItem="{Binding SelectedShutdownAction}"
                                          Width="180" Background="#181F2E" Foreground="#FFFFFF" BorderBrush="#2A344A"/>
                            </StackPanel>

                            <CheckBox Content="Force processes to terminate" IsChecked="{Binding ForceProcesses, Mode=TwoWay}"
                                      IsEnabled="{Binding ShutdownWhenDone}" Foreground="#8A9BB4" Margin="24,0,0,0"/>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>

            <!-- 3. Master Smooth Progress Bar -->
            <Grid Grid.Row="2" Margin="0,6,0,10">
                <ProgressBar Value="{Binding OverallPercentage, Mode=OneWay}" Maximum="100" Height="14"
                             Background="#141924" Foreground="#00E5FF" BorderThickness="0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid>
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00A2FF" Offset="0"/>
                                                        <GradientStop Color="#00E5FF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>

            <!-- 4. Control Action Bar (Hide/Show details, Pause, Cancel, Open) -->
            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Button Content="{Binding DetailsToggleText}" Command="{Binding ToggleDetailsCommand}"
                        Background="#19202E" Foreground="#8A9BB4" BorderBrush="#283348" BorderThickness="1"
                        Padding="14,6" HorizontalAlignment="Left" Cursor="Hand" FontSize="11" FontWeight="Medium"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- If completed, show Open File & Folder buttons -->
                    <Button Content="📂 Open File" Command="{Binding OpenFileCommand}"
                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"
                            Background="#00A2FF" Foreground="#FFFFFF" BorderThickness="0"
                            Padding="14,6" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold"/>

                    <Button Content="📁 Show in Folder" Command="{Binding OpenFolderCommand}"
                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"
                            Background="#1E2738" Foreground="#A0AEC0" BorderBrush="#2A354A" BorderThickness="1"
                            Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>

                    <!-- Pause / Resume -->
                    <Button Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}"
                            Background="#1F293A" Foreground="#E2E8F0" BorderBrush="#303E58" BorderThickness="1"
                            Padding="18,6" Margin="0,0,8,0" Cursor="Hand" FontWeight="Medium">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Cancel / Close -->
                    <Button Content="{Binding CancelButtonText}" Command="{Binding CancelCommand}"
                            Background="#181F2E" Foreground="#8A9BB4" BorderBrush="#263144" BorderThickness="1"
                            Padding="16,6" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- 5. Expandable Details Section: Connection Segment Bar + Threads Table -->
            <StackPanel Grid.Row="4" Visibility="{Binding IsDetailsVisible, Converter={StaticResource BoolToVis}}">
                <!-- Section Header -->
                <TextBlock Text="Start positions and download progress by connections:" 
                           Foreground="#8A9BB4" FontSize="11" Margin="0,0,0,6"/>

                <!-- The Signature Dynamic Segment Progress Bar -->
                <controls:ConnectionSegmentBar Threads="{Binding ConnectionThreads}" 
                                               TotalBytes="{Binding TotalBytes}" 
                                               IsCompleted="{Binding IsCompleted}"
                                               Height="18" Margin="0,0,0,8"/>

                <!-- Multi-Connection Threads Table -->
                <Border Background="#121722" BorderBrush="#222C3E" BorderThickness="1" CornerRadius="6" Height="130">
                    <DataGrid ItemsSource="{Binding ConnectionThreads}" AutoGenerateColumns="False"
                              Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                              RowBackground="#121722" AlternatingRowBackground="#151B27"
                              Foreground="#E2E8F0" GridLinesVisibility="None"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#171E2B"/>
                                <Setter Property="Foreground" Value="#8A9BB4"/>
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#222C3E"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#202A3D"/>
                                        <Setter Property="Foreground" Value="#00E5FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N." Binding="{Binding ThreadId}" Width="35"/>
                            <DataGridTextColumn Header="Start Position" Binding="{Binding FormattedStartPosition}" Width="110"/>
                            <DataGridTextColumn Header="Range" Binding="{Binding FormattedRange}" Width="160"/>
                            <DataGridTextColumn Header="Progress" Binding="{Binding FormattedProgress}" Width="75"/>
                            <DataGridTextColumn Header="Downloaded" Binding="{Binding FormattedDownloaded}" Width="110"/>
                            <DataGridTextColumn Header="Info" Binding="{Binding StatusInfo}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>

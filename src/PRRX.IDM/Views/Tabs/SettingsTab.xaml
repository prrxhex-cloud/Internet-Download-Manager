<UserControl x:Class="PRRX.IDM.Views.Tabs.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:PRRX.IDM.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="1400" d:DesignWidth="850">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:InverseBoolConverter x:Key="InvBool"/>
        <converters:FactorToPercentageConverter x:Key="FactorToPercent"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24,16,24,24">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <!-- Header Section -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Settings &amp; Preferences" FontSize="24" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                <TextBlock Text="Enterprise configuration, Windows 11 Fluent styling, End-to-End Encryption Vault, and In-App Updates." 
                           Opacity="0.7" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 1-Click In-App Seamless Updates Card (Top Priority) -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="12" Padding="20" Margin="0,0,0,18"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Seamless In-App Updates (Zero Data Loss)" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="Update PRRX IDM directly from within the app without opening websites or losing configurations." 
                                       Opacity="0.7" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#200078D4" BorderBrush="#400078D4" BorderThickness="1"
                                CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppVersion}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Update Status Banner -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Symbol="CloudSync24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding UpdateStatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="Medium"/>
                            <ui:ProgressRing Grid.Column="2" IsIndeterminate="True" Width="20" Height="20" 
                                             Visibility="{Binding IsCheckingUpdates, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>

                    <!-- Live In-App Download Progress Section -->
                    <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,14"
                            Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding UpdateDownloadProgressText}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{Binding UpdateDownloadProgress, StringFormat='{}{0:F0}%'}" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </Grid>
                            <Border CornerRadius="3" ClipToBounds="True">
                                <ProgressBar Value="{Binding UpdateDownloadProgress}" Maximum="100" Minimum="0" Height="6"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Updater Action Buttons -->
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Check for Updates" Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                                   Appearance="Secondary" Command="{Binding CheckForUpdatesCommand}" 
                                   IsEnabled="{Binding IsCheckingUpdates, Converter={StaticResource InvBool}}"
                                   Height="40" Margin="0,0,12,0" Padding="16,0"/>

                        <!-- 1-Click In-App Update Button -->
                        <ui:Button Content="Update Now (In-App)" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}"
                                   Appearance="Primary" Command="{Binding UpdateNowInAppCommand}" 
                                   Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                   IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource InvBool}}"
                                   Height="40" Margin="0,0,12,0" Padding="18,0"/>

                        <ui:Button Content="Open GitHub Release" Icon="{ui:SymbolIcon Symbol=Open24}"
                                   Appearance="Secondary" Command="{Binding OpenLatestReleaseCommand}" 
                                   Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                   Height="40" Padding="16,0"/>
                    </StackPanel>

                    <!-- Post-Update Auto-Cleanup Status & Action -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Broom24" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding CleanupStatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/>
                            <ui:Button Grid.Column="2" Content="Clean Cache Now" Appearance="Secondary" Command="{Binding CleanupCacheCommand}" 
                                       IsEnabled="{Binding IsCleaningCache, Converter={StaticResource InvBool}}" Padding="12,4" Height="32"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Dedicated Changelog & Version History Section (Fluent 2 Design) -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="12" Padding="20" Margin="0,0,0,18"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="History24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Changelog &amp; Version History" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="Detailed release records, performance improvements, security hardening, and new features." 
                                       Opacity="0.7" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#200078D4" BorderBrush="#400078D4" BorderThickness="1"
                                CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="All Releases" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Changelog Releases ItemsControl -->
                    <ItemsControl ItemsSource="{Binding ChangelogHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                        CornerRadius="8" Margin="0,0,0,12" Padding="14"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0">
                                        <Expander.Header>
                                            <Grid Margin="0,2,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Version Tag Badge -->
                                                <Border CornerRadius="6" Background="#200078D4" Padding="8,3" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Version}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                </Border>

                                                <!-- Status Badge -->
                                                <Border Grid.Column="1" CornerRadius="6" Background="#15107C41" Padding="8,3" Margin="0,0,12,0"
                                                        Visibility="{Binding IsCurrentRelease, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding StatusBadge}" FontWeight="SemiBold" FontSize="11" Foreground="#107C41"/>
                                                </Border>

                                                <!-- Release Date -->
                                                <TextBlock Grid.Column="2" Text="{Binding ReleaseDate}" Opacity="0.7" FontSize="12" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Expander.Header>

                                        <StackPanel Margin="0,12,0,4">
                                            <!-- Release Summary -->
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" Opacity="0.85" Margin="0,0,0,12"/>

                                            <!-- Categorized Changes List -->
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Category Badge -->
                                                            <Border Background="{Binding CategoryBgColor}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding Category}" FontWeight="Bold" FontSize="10" Foreground="{Binding CategoryBadgeColor}"/>
                                                            </Border>

                                                            <!-- Change Description -->
                                                            <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- End-to-End Encryption & Security Vault Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="12" Padding="20" Margin="0,0,0,18"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="#107C41" Margin="0,0,8,0"/>
                                <TextBlock Text="End-to-End Encryption Vault" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="AES-256-GCM &amp; Windows DPAPI encrypts stored configuration, credentials, and validates IPC channels." 
                                       Opacity="0.7" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#20107C41" BorderBrush="#40107C41" BorderThickness="1" 
                                CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="LockClosed24" Foreground="#107C41" Margin="0,0,4,0"/>
                                <TextBlock Text="Vault Active &amp; Sealed" FontWeight="Bold" FontSize="11" Foreground="#107C41"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Key24" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding SecurityVaultStatusText}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <ui:Button Content="Audit Security Vault &amp; Re-Encrypt" Icon="{ui:SymbolIcon Symbol=ShieldTask24}"
                               Appearance="Secondary" Command="{Binding AuditSecurityCommand}" 
                               Height="40" Padding="16,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Telegram Bot Remote Downloader (@PRRX_IDM_Bot) Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="12" Padding="20" Margin="0,0,0,18"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Telegram Bot Remote Downloader (@PRRX_IDM_Bot)" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Forward any movie, video, document, or audio file from your phone or Telegram Desktop to download instantly on this PC." 
                                       Opacity="0.7" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Live Status Badge -->
                        <Border Grid.Column="1" Background="{Binding TelegramStatusBadgeBackground}" 
                                BorderBrush="{Binding TelegramStatusBorderColor}" 
                                BorderThickness="1" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{Binding TelegramStatusSymbol}" FontSize="14" Margin="0,0,6,0" Foreground="{Binding TelegramStatusBadgeColor}"/>
                                <TextBlock Text="{Binding TelegramStatusText}" FontWeight="Bold" FontSize="11" Foreground="{Binding TelegramStatusBadgeColor}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Pairing and Status Panel -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="PAIRING CODE FOR THIS PC" FontSize="11" FontWeight="Bold" Opacity="0.6"/>
                                <TextBlock Text="{Binding TelegramPairingCode}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                <TextBlock Text="Send this pairing code to @PRRX_IDM_Bot or click Open Bot below." Opacity="0.7" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                <ui:Button Content="Open Bot (@PRRX_IDM_Bot)" Icon="{ui:SymbolIcon Symbol=Send24}"
                                           Appearance="Primary" Command="{Binding OpenTelegramBotCommand}" 
                                           Height="40" Margin="0,0,8,0" Padding="16,0"/>
                                <ui:Button Content="New Code" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"
                                           Appearance="Secondary" Command="{Binding RefreshTelegramPairingCommand}" 
                                           Height="40" Padding="12,0"/>
                            </StackPanel>

                            <!-- Live Connection Details Grid -->
                            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="12,10" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Linked User -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="LINKED TELEGRAM" FontSize="10" FontWeight="Bold" Opacity="0.6"/>
                                        <TextBlock Text="{Binding TelegramLinkedUser}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </StackPanel>

                                    <!-- Last Heartbeat -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="LAST CLOUD SYNC" FontSize="10" FontWeight="Bold" Opacity="0.6"/>
                                        <TextBlock Text="{Binding TelegramLastHeartbeatText}" FontSize="12" FontWeight="Normal" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Pending Queue -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="REMOTE QUEUE" FontSize="10" FontWeight="Bold" Opacity="0.6"/>
                                        <TextBlock Text="{Binding TelegramActiveTasksCount, StringFormat='{}{0} tasks queued'}" FontSize="12" FontWeight="Normal" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Action Controls & Diagnostic Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:Button Content="Test Connection" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"
                                   Appearance="Secondary" Command="{Binding TestTelegramConnectionCommand}"
                                   Height="34" Margin="0,0,8,0" Padding="12,0"
                                   IsEnabled="{Binding IsTestingTelegram, Converter={StaticResource InvBool}}"/>
                        <ui:Button Content="Force Heartbeat" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"
                                   Appearance="Secondary" Command="{Binding ForceTelegramHeartbeatCommand}"
                                   Height="34" Margin="0,0,8,0" Padding="12,0"
                                   IsEnabled="{Binding IsTestingTelegram, Converter={StaticResource InvBool}}"/>
                        <ui:Button Content="Re-Pair" Icon="{ui:SymbolIcon Symbol=QrCode24}"
                                   Appearance="Secondary" Command="{Binding RePairTelegramCommand}"
                                   Height="34" Margin="0,0,8,0" Padding="12,0"
                                   IsEnabled="{Binding IsTestingTelegram, Converter={StaticResource InvBool}}"/>
                        <ui:Button Content="Unlink" Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                                   Appearance="Danger" Command="{Binding UnlinkTelegramCommand}"
                                   Height="34" Padding="12,0"
                                   IsEnabled="{Binding IsTelegramLinked}"/>
                    </StackPanel>

                    <!-- Action Feedback Banner -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TelegramActionFeedback}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TelegramActionFeedback}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info24" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding TelegramActionFeedback}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <CheckBox Content="Enable automated background download sync from @PRRX_IDM_Bot"
                              IsChecked="{Binding IsTelegramBotEnabled, Mode=TwoWay}"
                              FontWeight="Medium" Margin="2,0,0,0"/>
                    <CheckBox Content="Keep running in system tray on close (background sync stays active)"
                              IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}"
                              FontWeight="Medium" Margin="2,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Interactive Guides & Tutorials Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="12" Padding="20" Margin="0,0,0,18"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Interactive Guides &amp; Tutorials" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Launch the 5-step browser integration guide or replay the feature walkthrough anytime." 
                                   Opacity="0.7" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Content="Setup Tutorial" Icon="{ui:SymbolIcon Symbol=BookQuestionMark24}"
                                   Appearance="Secondary" Command="{Binding ReplayOnboardingCommand}" Height="40" Margin="0,0,10,0"/>
                        <ui:Button Content="Replay Feature Tour" Icon="{ui:SymbolIcon Symbol=PlayCircle24}"
                                   Appearance="Secondary" Command="{Binding ReplayQuickTourCommand}" Height="40"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Media Extraction Engine Auto-Updater Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="12" Padding="20" Margin="0,0,0,18"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Media Extraction Engine (yt-dlp Core)" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Directly updates online platform extraction algorithms so YouTube and TikTok downloads never break." 
                                       Opacity="0.7" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#20107C41" BorderBrush="#40107C41" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="Core Engine Active" FontWeight="Bold" FontSize="11" Foreground="#107C41"/>
                        </Border>
                    </Grid>

                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Symbol="Flash24" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding EngineStatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <ui:ProgressRing Grid.Column="2" IsIndeterminate="True" Width="20" Height="20" 
                                             Visibility="{Binding IsUpdatingEngine, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>

                    <ui:Button Content="Update Extraction Engine Now" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}"
                               Appearance="Secondary" Command="{Binding UpdateEngineCommand}" 
                               IsEnabled="{Binding IsUpdatingEngine, Converter={StaticResource InvBool}}"
                               Height="40" Padding="16,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Appearance & Liquid Glass Theme Section -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="12" Padding="20" Margin="0,0,0,18"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Appearance &amp; Windows 11 Liquid Glass UI" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <TextBlock Text="Application Theme" FontWeight="Medium" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:Button Content="System Default" Icon="{ui:SymbolIcon Symbol=Laptop24}"
                                   Command="{Binding SetThemeCommand}" CommandParameter="System" 
                                   Margin="0,0,10,0" Height="40" Padding="16,0"/>
                        <ui:Button Content="Light Theme" Icon="{ui:SymbolIcon Symbol=WeatherSunny24}"
                                   Command="{Binding SetThemeCommand}" CommandParameter="Light" 
                                   Margin="0,0,10,0" Height="40" Padding="16,0"/>
                        <ui:Button Content="Dark Theme" Icon="{ui:SymbolIcon Symbol=WeatherMoon24}"
                                   Command="{Binding SetThemeCommand}" CommandParameter="Dark" 
                                   Height="40" Padding="16,0"/>
                    </StackPanel>

                    <!-- Windows 11 Liquid Glass Transparency Slider -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Liquid Glass Transparency &amp; Mica Blur" FontWeight="SemiBold"/>
                                    <TextBlock Text="Controls dynamic backdrop transparency level and frosted glass refraction on Windows 11." 
                                               Opacity="0.7" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding TransparencyFactor, Converter={StaticResource FactorToPercent}}" 
                                           FontWeight="Bold" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </Grid>

                            <Slider Minimum="0.20" Maximum="1.0" Value="{Binding TransparencyFactor, Mode=TwoWay}"
                                    IsEnabled="{Binding IsWin11}" SmallChange="0.05" LargeChange="0.1" Margin="0,4,0,0"/>

                            <TextBlock Text="* Liquid Glass mode requires Windows 11 (Build 22000+) hardware composition." 
                                       FontSize="11" Foreground="#FF8C00" Margin="0,6,0,0"
                                       Visibility="{Binding IsWin11, Converter={StaticResource InvBoolToVis}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Browser Integration & Extension Module Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="12" Padding="20" Margin="0,0,0,18"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Browser Integration &amp; Extension Module (Chrome / Edge / Brave)" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Intercept browser downloads, grab video/audio with floating player button, and download with multi-socket speed." 
                                       Opacity="0.7" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#2000E5FF" BorderBrush="#4000E5FF" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="Native Host Active" FontWeight="Bold" FontSize="11" Foreground="#00E5FF"/>
                        </Border>
                    </Grid>

                    <!-- Status Message Banner -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Link24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding BrowserStatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Unpacked Extension File Path Display & Copy Button -->
                    <TextBlock Text="Unpacked Browser Extension Location:" FontWeight="Medium" FontSize="12" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" Text="{Binding ExtensionDirectory, Mode=OneWay}" 
                                    IsReadOnly="True" Height="40" Margin="0,0,10,0" VerticalContentAlignment="Center"/>

                        <ui:Button Grid.Column="1" Content="Copy Path" Icon="{ui:SymbolIcon Symbol=Copy24}"
                                   Command="{Binding CopyExtensionPathCommand}" Height="40" Margin="0,0,10,0" Padding="14,0"/>

                        <ui:Button Grid.Column="2" Content="Open Folder" Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                   Appearance="Secondary" Command="{Binding OpenExtensionFolderCommand}" Height="40" Padding="14,0"/>
                    </Grid>

                    <!-- Action Helpers: Register Host & Open Browser Extensions Pages -->
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Register Native Host" Icon="{ui:SymbolIcon Symbol=Checkmark24}"
                                   Appearance="Primary" Command="{Binding InstallBrowserExtensionCommand}" 
                                   Height="40" Margin="0,0,10,0" Padding="16,0"/>

                        <ui:Button Content="Install in Chrome" Icon="{ui:SymbolIcon Symbol=Globe24}"
                                   Appearance="Secondary" Command="{Binding OpenChromeExtensionsCommand}" 
                                   Height="40" Margin="0,0,10,0" Padding="14,0"/>

                        <ui:Button Content="Install in Edge" Icon="{ui:SymbolIcon Symbol=Globe24}"
                                   Appearance="Secondary" Command="{Binding OpenEdgeExtensionsCommand}" 
                                   Height="40" Padding="14,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Turbo Multi-Connection Chunk Acceleration Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="12" Padding="20" Margin="0,0,0,18"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Turbo Download Acceleration (Multi-Threaded Streams)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Splits downloads into parallel concurrent network streams to saturate your internet bandwidth." 
                               Opacity="0.7" FontSize="12" Margin="0,0,0,14"/>

                    <CheckBox Content="Enable Multi-Connection Turbo Speed Acceleration" 
                              IsChecked="{Binding EnableTurboAcceleration, Mode=TwoWay}" 
                              FontWeight="Medium" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Parallel Connection Streams:" VerticalAlignment="Center" FontWeight="Medium" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableStreamCounts}" 
                                  SelectedItem="{Binding TurboConnectionCount, Mode=TwoWay}" 
                                  IsEnabled="{Binding EnableTurboAcceleration}" Height="38"/>
                    </Grid>
                    <TextBlock Text="Recommended: 16 streams for balanced throughput; up to 64 streams for ultra-high-speed fiber networks." 
                               FontSize="11" Opacity="0.6"/>
                </StackPanel>
            </Border>

            <!-- Manual Proxy Server Configuration Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="12" Padding="20" Margin="0,0,0,18"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Router24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Manual Proxy Server &amp; Network Routing" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="Route downloads through HTTP, HTTPS, SOCKS4, or SOCKS5 proxies with enterprise authentication." 
                                       Opacity="0.7" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>

                        <CheckBox Grid.Column="1" Content="Enable Proxy" IsChecked="{Binding UseProxy, Mode=TwoWay}"
                                  FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14"
                            IsEnabled="{Binding UseProxy}">
                        <StackPanel>
                            <!-- Proxy Protocol Type, Host, Port -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Protocol" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox SelectedValue="{Binding SelectedProxyType, Mode=TwoWay}" SelectedValuePath="Tag" Height="36">
                                        <ComboBoxItem Content="HTTP" Tag="{x:Static models:ProxyType.Http}" xmlns:models="clr-namespace:PRRX.IDM.Models" IsSelected="True"/>
                                        <ComboBoxItem Content="HTTPS" Tag="{x:Static models:ProxyType.Https}" xmlns:models="clr-namespace:PRRX.IDM.Models"/>
                                        <ComboBoxItem Content="SOCKS4" Tag="{x:Static models:ProxyType.Socks4}" xmlns:models="clr-namespace:PRRX.IDM.Models"/>
                                        <ComboBoxItem Content="SOCKS5" Tag="{x:Static models:ProxyType.Socks5}" xmlns:models="clr-namespace:PRRX.IDM.Models"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Proxy Server Host / IP" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                    <ui:TextBox Text="{Binding ProxyHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                PlaceholderText="127.0.0.1 or proxy.corp.local" Height="36"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Port" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                    <ui:TextBox Text="{Binding ProxyPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                PlaceholderText="8080" Height="36"/>
                                </StackPanel>
                            </Grid>

                            <!-- Proxy Authentication -->
                            <CheckBox Content="Proxy server requires authentication" 
                                      IsChecked="{Binding UseProxyAuth, Mode=TwoWay}"
                                      FontWeight="Medium" Margin="0,0,0,10"/>

                            <Grid IsEnabled="{Binding UseProxyAuth}" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Username" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ui:TextBox Text="{Binding ProxyUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                PlaceholderText="Proxy Username" Height="34"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Password" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ui:PasswordBox Password="{Binding ProxyPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                    PlaceholderText="Proxy Password" Height="34"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="* Supports Basic, Digest, NTLM, and Kerberos/Negotiate authentication with automatic fallback." 
                                       FontSize="11" Opacity="0.6" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Storage & Downloads Location Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="12" Padding="20" Margin="0,0,0,18"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Storage &amp; Downloads" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="Default Save Location" FontWeight="Medium" Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Text="{Binding DownloadDirectory, Mode=TwoWay}" Height="40" Margin="0,0,10,0"/>
                        <ui:Button Grid.Column="1" Content="Change Folder" Icon="{ui:SymbolIcon Symbol=FolderSearch24}" 
                                   Command="{Binding BrowseFolderCommand}" Height="40"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Windows Startup & System Integration Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="12" Padding="20" Margin="0,0,0,18"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="System Integration &amp; Priority" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Configure Windows process scheduling priority and silent background startup." 
                               Opacity="0.7" FontSize="12" Margin="0,0,0,14"/>

                    <!-- Process & Network Priority Dropdown -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Process &amp; Network Priority:" FontWeight="SemiBold"/>
                            <TextBlock Text="Windows I/O thread priority allocation" FontSize="11" Opacity="0.6"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailablePriorities}" 
                                  SelectedItem="{Binding SelectedPriority, Mode=TwoWay}" 
                                  Height="38"/>
                    </Grid>
                    <TextBlock Text="* Default is 'High' to prioritize network packets and prevent multi-connection download stalls during heavy gaming or browser multitasking." 
                               FontSize="11" Opacity="0.65" Margin="0,0,0,16"/>

                    <CheckBox Content="Start PRRX IDM silently on Windows startup (Background Preload)" 
                              IsChecked="{Binding LaunchOnStartup, Mode=TwoWay}" 
                              FontWeight="Medium" Margin="0,0,0,8"/>
                    <TextBlock Text="When enabled, IDM loads all configurations, browser native messaging, and download listeners silently in the background when your PC boots without opening the main window." 
                               FontSize="11" Opacity="0.6"/>
                </StackPanel>
            </Border>

            <!-- Company Info, Watermark & Branding -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="12" Padding="20"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Margin="0,0,16,0" VerticalAlignment="Center" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/app_icon.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="PRRX Internet Download Manager (PRRX IDM™)" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="Copyright © 2026 PRRX Cooperation. All Rights Reserved. Watermark: PRRX-IDM-CORE-WATERMARK-SECURE-VAULT-2026" Opacity="0.8" FontSize="12" Margin="0,4,0,2"/>
                        <TextBlock Text="Confidential &amp; Proprietary Engine. Certified Windows 11 Fluent 2 &amp; Zero-Knowledge Security Vault." Opacity="0.6" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="PRRX.IDM.Views.Tabs.SiteGrabberTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:PRRX.IDM.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="900">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:InverseBoolConverter x:Key="InvBool"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header with Status Badge -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Web Site Spider &amp; Grabber" FontSize="24" FontWeight="Bold"/>
                    <Border Background="#200078D4" BorderBrush="#400078D4" BorderThickness="1" 
                            CornerRadius="12" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="GlobeSearch24" Foreground="#0078D4" Margin="0,0,4,0"/>
                            <TextBlock Text="Deep Multi-Level Crawler • Site Mirror" FontSize="11" FontWeight="SemiBold" Foreground="#0078D4"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Crawl websites recursively up to 5 levels or entire domains, filter documents, media, or images, and schedule batch downloads." 
                           Opacity="0.75" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Grabber Configuration Card -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="10" Padding="18" Margin="0,0,0,16"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <!-- Project Name & Start URL -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Project Name" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ui:TextBox Text="{Binding CurrentProject.ProjectName, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Start Website Address (URL)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ui:TextBox Text="{Binding CurrentProject.StartUrl, UpdateSourceTrigger=PropertyChanged}" 
                                        PlaceholderText="https://example.com" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <!-- Exploration Depth & Filter Preset -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Depth Selector -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Exploration Depth" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox SelectedValue="{Binding CurrentProject.ExplorationDepth}" SelectedValuePath="Tag" Height="36" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="1 Level (Start Page Only)" Tag="1"/>
                                <ComboBoxItem Content="2 Levels (Direct Links)" Tag="2" IsSelected="True"/>
                                <ComboBoxItem Content="3 Levels (Deep Crawl)" Tag="3"/>
                                <ComboBoxItem Content="4 Levels (Intense Crawl)" Tag="4"/>
                                <ComboBoxItem Content="5 Levels (Ultra Deep)" Tag="5"/>
                                <ComboBoxItem Content="Whole Domain (Unlimited)" Tag="0"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Filter Preset -->
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Capture Filter Preset" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox SelectedValue="{Binding CurrentProject.FilterPreset}" SelectedValuePath="Tag" Height="36" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="All Images (JPG, PNG, WebP, SVG)" Tag="{x:Static models:GrabberFilterPreset.AllImages}" xmlns:models="clr-namespace:PRRX.IDM.Models" IsSelected="True"/>
                                <ComboBoxItem Content="All Documents (PDF, Office, Text)" Tag="{x:Static models:GrabberFilterPreset.AllDocuments}" xmlns:models="clr-namespace:PRRX.IDM.Models"/>
                                <ComboBoxItem Content="All Media (Video &amp; Audio)" Tag="{x:Static models:GrabberFilterPreset.AllMedia}" xmlns:models="clr-namespace:PRRX.IDM.Models"/>
                                <ComboBoxItem Content="All Files (Media + Docs + Archives)" Tag="{x:Static models:GrabberFilterPreset.AllFiles}" xmlns:models="clr-namespace:PRRX.IDM.Models"/>
                                <ComboBoxItem Content="Complete Website (Mirror HTML &amp; Assets)" Tag="{x:Static models:GrabberFilterPreset.CompleteWebsite}" xmlns:models="clr-namespace:PRRX.IDM.Models"/>
                                <ComboBoxItem Content="Custom Extensions / Regex" Tag="{x:Static models:GrabberFilterPreset.Custom}" xmlns:models="clr-namespace:PRRX.IDM.Models"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Custom Extensions or Regex Filter -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Custom Extensions (comma separated)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ui:TextBox Text="{Binding CurrentProject.CustomExtensions, UpdateSourceTrigger=PropertyChanged}" 
                                        PlaceholderText="jpg,png,pdf,mp4" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <!-- Advanced Options & Regex -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="URL Regex Filter (Optional)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ui:TextBox Text="{Binding CurrentProject.RegexFilter, UpdateSourceTrigger=PropertyChanged}" 
                                        PlaceholderText="e.g. .*\.(pdf|zip)$" Height="36"/>
                        </StackPanel>

                        <CheckBox Grid.Column="1" Content="Stay on Domain" IsChecked="{Binding CurrentProject.StayOnDomain}"
                                  VerticalAlignment="Center" Margin="0,18,0,0"/>

                        <CheckBox Grid.Column="2" Content="Save Directory Tree" IsChecked="{Binding CurrentProject.SaveStructure}"
                                  VerticalAlignment="Center" Margin="0,18,0,0"/>
                    </Grid>

                    <!-- Save Directory -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Destination Save Directory" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ui:TextBox Text="{Binding CurrentProject.SaveDirectory, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                        </StackPanel>

                        <ui:Button Grid.Column="1" Content="Browse..." Icon="{ui:SymbolIcon Symbol=Folder24}"
                                   Command="{Binding BrowseDirectoryCommand}" Height="36" VerticalAlignment="Bottom" Margin="0,0,8,0"/>

                        <ui:Button Grid.Column="2" Content="Open Folder" Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                   Command="{Binding OpenTargetFolderCommand}" Height="36" VerticalAlignment="Bottom"/>
                    </Grid>

                    <!-- Scheduling Options -->
                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Scheduling Mode" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding CurrentProject.ScheduleMode}" SelectedValuePath="Tag" Height="34" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Run Immediately" Tag="{x:Static models:GrabberScheduleMode.RunImmediately}" xmlns:models="clr-namespace:PRRX.IDM.Models" IsSelected="True"/>
                                    <ComboBoxItem Content="Run Once at Specified Time" Tag="{x:Static models:GrabberScheduleMode.RunOnceAtTime}" xmlns:models="clr-namespace:PRRX.IDM.Models"/>
                                    <ComboBoxItem Content="Periodic Every N Hours" Tag="{x:Static models:GrabberScheduleMode.PeriodicEveryNHours}" xmlns:models="clr-namespace:PRRX.IDM.Models"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Recurrence Interval" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding CurrentProject.PeriodicHours}" SelectedValuePath="Tag" Height="34" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Every 1 Hour" Tag="1"/>
                                    <ComboBoxItem Content="Every 2 Hours" Tag="2"/>
                                    <ComboBoxItem Content="Every 4 Hours" Tag="4"/>
                                    <ComboBoxItem Content="Every 6 Hours" Tag="6" IsSelected="True"/>
                                    <ComboBoxItem Content="Every 12 Hours" Tag="12"/>
                                    <ComboBoxItem Content="Every 24 Hours (Daily)" Tag="24"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <ui:Button Content="Schedule Grabber" Icon="{ui:SymbolIcon Symbol=Clock24}"
                                           Command="{Binding ScheduleCommand}" Appearance="Primary" Height="34" Margin="0,0,8,0"/>
                                <ui:Button Content="Unschedule" Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                                           Command="{Binding UnscheduleCommand}" Appearance="Secondary" Height="34"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Control Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:Button Grid.Column="0" Content="Start Spider &amp; Grabber" Icon="{ui:SymbolIcon Symbol=GlobeSearch24}"
                                   Appearance="Primary" Command="{Binding StartCrawlCommand}" Height="40" Padding="18,0" Margin="0,0,10,0"/>

                        <ui:Button Grid.Column="1" Content="Stop" Icon="{ui:SymbolIcon Symbol=Stop24}"
                                   Appearance="Danger" Command="{Binding StopCommand}" Height="40" Padding="16,0" Margin="0,0,10,0"/>

                        <ui:Button Grid.Column="3" Content="Download All Discovered" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}"
                                   Appearance="Primary" Command="{Binding DownloadAllCommand}" Height="40" Padding="16,0" Margin="0,0,10,0"/>


                        <ui:Button Grid.Column="4" Content="Clear Results" Icon="{ui:SymbolIcon Symbol=Delete24}"
                                   Appearance="Secondary" Command="{Binding ClearResultsCommand}" Height="40" Padding="14,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Live Status & Stats Bar -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="{Binding IsBusy}" Width="16" Height="16" Margin="0,0,10,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding CurrentProject.PagesCrawled, StringFormat='Pages: {0}'}" 
                               FontSize="12" Margin="16,0" VerticalAlignment="Center" Opacity="0.8"/>

                    <TextBlock Grid.Column="2" Text="{Binding CurrentProject.FilesFound, StringFormat='Found: {0}'}" 
                               FontSize="12" Margin="16,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>

                    <TextBlock Grid.Column="3" Text="{Binding CurrentProject.FilesDownloaded, StringFormat='Saved: {0}'}" 
                               FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#107C41"/>
                </Grid>
            </Border>

            <!-- Results DataGrid -->
            <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="10" Padding="16"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" MinHeight="300">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40"
                                Visibility="{Binding HasFoundFiles, Converter={StaticResource InvBoolToVis}}">
                        <Border Background="#100078D4" Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="GlobeSearch24" FontSize="30" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                        </Border>
                        <TextBlock Text="No Discovered Files Yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Configure a target site URL and click 'Start Spider &amp; Grabber' to explore web assets." 
                                   FontSize="12" Opacity="0.7" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Files Table -->
                    <DataGrid ItemsSource="{Binding FoundFiles}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False"
                              Visibility="{Binding HasFoundFiles, Converter={StaticResource BoolToVis}}"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                              RowHeight="40" HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.Columns>
                            <!-- File Name -->
                            <DataGridTemplateColumn Header="File Name" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <ui:SymbolIcon Symbol="Document24" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status -->
                            <DataGridTemplateColumn Header="Status" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#15107C41" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="#107C41"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Size -->
                            <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="90"/>

                            <!-- URL -->
                            <DataGridTextColumn Header="Remote URL" Binding="{Binding Url}" Width="2.5*"/>

                            <!-- Local Destination -->
                            <DataGridTextColumn Header="Local Target Path" Binding="{Binding LocalPath}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

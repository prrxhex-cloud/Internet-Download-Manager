<UserControl x:Class="PRRX.IDM.Views.Tabs.ApkHubTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:PRRX.IDM.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="950">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:InverseBoolConverter x:Key="InvBool"/>
    </UserControl.Resources>

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Cloud Engine Status Badge -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Android APK &amp; MOD Store" FontSize="24" FontWeight="Bold"/>
                <Border Background="#2022C55E" BorderBrush="#4022C55E" BorderThickness="1" 
                        CornerRadius="12" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ShieldCheckmark20" Foreground="#4ADE80" Margin="0,0,6,0"/>
                        <TextBlock Text="22+ SASA Cloud Debrid Engines Active" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock Text="Search, inspect, and download official Android packages and unlocked MODs directly with multi-connection fiber speed." 
                       Opacity="0.75" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Search Bar & Store Selector Card -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                CornerRadius="10" Padding="16" Margin="0,0,0,12"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                PlaceholderText="Search Android packages or MODs (e.g. WhatsApp, Minecraft, Subway Surfers, Spotify)..."
                                Height="40" Margin="0,0,10,0" VerticalContentAlignment="Center"
                                Icon="{ui:SymbolIcon Symbol=Search24}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>

                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableProviders}" 
                              SelectedItem="{Binding SelectedProvider}"
                              Height="40" Margin="0,0,10,0" VerticalContentAlignment="Center"/>

                    <ui:Button Grid.Column="2" Content="Search Store" Icon="{ui:SymbolIcon Symbol=Search24}" 
                               Command="{Binding SearchCommand}" Appearance="Primary"
                               Height="40" Padding="18,0"/>
                </Grid>

                <!-- Quick Discovery Chips -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Popular:" Opacity="0.6" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <ui:Button Content="WhatsApp" Appearance="Secondary" Height="26" Padding="10,0" Margin="0,0,6,0" FontSize="11"
                               Command="{Binding QuickSearchCommand}" CommandParameter="WhatsApp"/>

                    <ui:Button Content="Minecraft" Appearance="Secondary" Height="26" Padding="10,0" Margin="0,0,6,0" FontSize="11"
                               Command="{Binding QuickSearchCommand}" CommandParameter="Minecraft"/>

                    <ui:Button Content="Subway Surfers" Appearance="Secondary" Height="26" Padding="10,0" Margin="0,0,6,0" FontSize="11"
                               Command="{Binding QuickSearchCommand}" CommandParameter="Subway Surfers"/>

                    <ui:Button Content="Spotify MOD" Appearance="Secondary" Height="26" Padding="10,0" Margin="0,0,6,0" FontSize="11"
                               Command="{Binding QuickSearchCommand}" CommandParameter="Spotify"/>

                    <ui:Button Content="Telegram" Appearance="Secondary" Height="26" Padding="10,0" Margin="0,0,6,0" FontSize="11"
                               Command="{Binding QuickSearchCommand}" CommandParameter="Telegram"/>

                    <ui:Button Content="Instagram" Appearance="Secondary" Height="26" Padding="10,0" Margin="0,0,6,0" FontSize="11"
                               Command="{Binding QuickSearchCommand}" CommandParameter="Instagram"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Status & Progress Bar -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Info20" Opacity="0.7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.85" VerticalAlignment="Center"/>
                </StackPanel>

                <ui:ProgressRing Grid.Column="1" IsIndeterminate="True" Width="18" Height="18"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- Results View -->
        <Grid Grid.Row="3">
            <!-- Results List with Virtualization -->
            <ListView ItemsSource="{Binding ApkResults}" SelectedItem="{Binding SelectedApk}"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      VirtualizingStackPanel.ScrollUnit="Pixel"
                      BorderThickness="0" Background="Transparent"
                      Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- App Icon -->
                                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="8" ClipToBounds="True" 
                                        Background="#15FFFFFF" VerticalAlignment="Center">
                                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- App Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <!-- Store Badge -->
                                        <Border Background="#2538BDF8" BorderBrush="#5038BDF8" BorderThickness="1" 
                                                CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Provider}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Version Badge -->
                                        <Border Background="#1CFFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1"
                                                CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Version}" FontSize="11" Foreground="#CBD5E1"/>
                                        </Border>

                                        <!-- Size Badge -->
                                        <Border Background="#1CFFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1"
                                                CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding Size}" FontSize="11" Foreground="#CBD5E1"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Download Button -->
                                <ui:Button Grid.Column="2" Content="Download APK" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" 
                                           Appearance="Primary" Height="36" Padding="14,0" VerticalAlignment="Center"
                                           Command="{Binding DataContext.DownloadApkCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                           CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty / Loading State Placeholder -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasResults, Converter={StaticResource InvBoolToVis}}">
                <ui:SymbolIcon Symbol="Apps28" FontSize="48" Opacity="0.3" Margin="0,0,0,12"/>
                <TextBlock Text="Ready to Search Android Repositories" FontSize="16" FontWeight="SemiBold" 
                           Opacity="0.7" HorizontalAlignment="Center"/>
                <TextBlock Text="Search across Ultra v2, HappyMod, AN1, APKPure, and Uptodown." 
                           FontSize="12" Opacity="0.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

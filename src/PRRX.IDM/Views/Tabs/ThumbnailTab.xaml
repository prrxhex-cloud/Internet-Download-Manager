<UserControl x:Class="PRRX.IDM.Views.Tabs.ThumbnailTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:PRRX.IDM.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="900">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:InverseBoolConverter x:Key="InvBool"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header with Liquid Glass Badge -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Thumbnail Grabber" FontSize="24" FontWeight="Bold"/>
                    <Border Background="#200078D4" BorderBrush="#400078D4" BorderThickness="1" 
                            CornerRadius="12" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Image24" Foreground="#0078D4" Margin="0,0,4,0"/>
                            <TextBlock Text="Ultra HD 1080p Artwork" FontSize="11" FontWeight="SemiBold" Foreground="#0078D4"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Extract and save original YouTube video cover art and wallpapers in maximum resolution." 
                           Opacity="0.75" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Input Bar Card (Liquid Glass Style) -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="10" Padding="16" Margin="0,0,0,14"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Text="{Binding InputUrl, UpdateSourceTrigger=PropertyChanged}" 
                                PlaceholderText="Paste any YouTube video link here..." 
                                FontSize="14" Height="42" Margin="0,0,10,0"/>

                    <ui:Button Grid.Column="1" Content="Paste" Icon="{ui:SymbolIcon Symbol=ClipboardPaste24}" 
                               Command="{Binding PasteClipboardCommand}" Margin="0,0,10,0" Height="42"/>

                    <ui:Button Grid.Column="2" Content="Extract Thumbnails" Icon="{ui:SymbolIcon Symbol=ImageSearch24}" 
                               Appearance="Primary" Command="{Binding ExtractThumbnailsCommand}" 
                               IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}" Height="42"/>
                </Grid>
            </Border>

            <!-- Status Banner -->
            <Border Grid.Row="2" Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Symbol="Info24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" 
                               FontWeight="Medium" TextTrimming="CharacterEllipsis"/>

                    <ui:ProgressRing Grid.Column="2" IsIndeterminate="True" Width="20" Height="20" Margin="10,0,0,0"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <!-- HD Thumbnail Gallery Grid -->
            <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="10" Padding="18"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Gallery Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ImageCopy24" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Available High-Resolution Thumbnails" FontWeight="SemiBold" FontSize="16"/>
                        </StackPanel>

                        <ui:Button Grid.Column="1" Content="Open Downloads Folder" Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                   Command="{Binding OpenOutputFolderCommand}" Appearance="Secondary" Height="36"/>
                    </Grid>

                    <!-- Gallery Items -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding AvailableThumbnails}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="8" Padding="14" 
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <!-- Card Top Badges -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Quality Badge -->
                                            <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="6" Padding="8,3">
                                                <TextBlock Text="{Binding QualityBadge}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            </Border>

                                            <!-- Dimensions & File Size -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Dimensions}" FontWeight="SemiBold" FontSize="11" Opacity="0.8" Margin="0,0,6,0"/>
                                                <TextBlock Text="•" FontSize="11" Opacity="0.4" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding EstimatedSizeFormatted}" FontWeight="SemiBold" FontSize="11" Opacity="0.6"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Image Preview Box -->
                                        <Border CornerRadius="8" ClipToBounds="True" Background="#20000000" Height="170" Margin="0,0,0,12">
                                            <Image Source="{Binding Url}" Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- Title -->
                                        <TextBlock Text="{Binding ResolutionTitle}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>

                                        <!-- Action Buttons Toolbar -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Download Image Button -->
                                            <ui:Button Content="Download Image" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}"
                                                       Appearance="Primary" Height="36"
                                                       Command="{Binding DataContext.DownloadSpecificThumbnailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       HorizontalAlignment="Stretch"/>

                                            <!-- Copy Link Button -->
                                            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Symbol=Copy24}" 
                                                       ToolTip="Copy Direct Image Link"
                                                       Appearance="Secondary" Height="36" Width="40" Margin="8,0,0,0" Padding="0"
                                                       Command="{Binding DataContext.CopyUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

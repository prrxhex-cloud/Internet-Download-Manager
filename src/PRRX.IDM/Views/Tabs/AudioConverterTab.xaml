<UserControl x:Class="PRRX.IDM.Views.Tabs.AudioConverterTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:PRRX.IDM.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="900">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:InverseBoolConverter x:Key="InvBool"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header with Liquid Glass Badge -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Universal Audio Converter" FontSize="24" FontWeight="Bold"/>
                    <Border Background="#20107C41" BorderBrush="#40107C41" BorderThickness="1" 
                            CornerRadius="12" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="MusicNote224" Foreground="#107C41" Margin="0,0,4,0"/>
                            <TextBlock Text="MP3 • WAV • iPhone M4R • FLAC • OGG • AMR" FontSize="11" FontWeight="SemiBold" Foreground="#107C41"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Convert any local video/audio file or online link into pristine studio audio or custom iPhone ringtones." 
                           Opacity="0.75" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Step 1: Internet Media Source & Live Inspector Card -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="10" Padding="16" Margin="0,0,0,14"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="1. Select Internet Download Source" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Paste any online media URL (YouTube, TikTok, Telegram) or select an active IDM download." 
                                       FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#150078D4" BorderBrush="#300078D4" BorderThickness="1" CornerRadius="4" Padding="8,3">
                            <TextBlock Text="Internet Downloads Only" FontSize="10" FontWeight="Bold" Foreground="#0078D4"/>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Text="{Binding SourceInput, UpdateSourceTrigger=PropertyChanged}" 
                                    PlaceholderText="Paste online media link (https://..., t.me/..., tg://file...)..." 
                                    FontSize="14" Height="42" Margin="0,0,10,0"/>

                        <ui:Button Grid.Column="1" Content="Paste Link" Icon="{ui:SymbolIcon Symbol=ClipboardPaste24}" 
                                   Command="{Binding PasteClipboardCommand}" Height="42" Padding="16,0"/>
                    </Grid>

                    <!-- Auto-Detected Source Format Banner -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="DocumentSearch24" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Source Status: " FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                                <TextBlock Text="{Binding DetectedSourceFormat}" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                            <ui:ProgressRing Grid.Column="2" IsIndeterminate="True" Width="16" Height="16"
                                             Visibility="{Binding IsAnalyzingSource, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>

                    <!-- Live Media Preview & Technical Inspector (User Requested) -->
                    <Border Visibility="{Binding HasMediaPreview, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="12" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Thumbnail Preview -->
                            <Border Grid.Column="0" Width="100" Height="68" CornerRadius="6" Margin="0,0,14,0" 
                                    Background="#20000000" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding MediaThumbnailUrl}" Stretch="UniformToFill"/>
                                    <ui:SymbolIcon Symbol="PlayCircle24" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                   Foreground="White" Opacity="0.9"/>
                                </Grid>
                            </Border>

                            <!-- Technical Details Inspector -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MediaTitle}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding MediaPublisher}" FontSize="12" Opacity="0.75" Margin="0,2,0,6"/>

                                <!-- Badges Row: Bitrate, Codec, Duration -->
                                <WrapPanel Orientation="Horizontal">
                                    <Border Background="#200078D4" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <TextBlock Text="{Binding MediaAudioCodec}" FontSize="11" FontWeight="SemiBold" Foreground="#0078D4"/>
                                    </Border>
                                    <Border Background="#20107C41" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <TextBlock Text="{Binding MediaBitrate}" FontSize="11" FontWeight="SemiBold" Foreground="#107C41"/>
                                    </Border>
                                    <Border Background="#20D83B01" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <TextBlock Text="{Binding MediaDuration}" FontSize="11" FontWeight="SemiBold" Foreground="#D83B01"/>
                                    </Border>
                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <TextBlock Text="{Binding MediaResolution}" FontSize="11" Opacity="0.85"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Step 2: Target Audio Format Selector Grid -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="10" Padding="16" Margin="0,0,0,14"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="2. Choose Target Output Format" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                    <!-- Target Formats Combo -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Convert Target Format:" VerticalAlignment="Center" FontWeight="Medium" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding TargetFormats}" 
                                  SelectedItem="{Binding SelectedTargetFormat}"
                                  DisplayMemberPath="DisplayName" Height="40"/>
                    </Grid>

                    <!-- Target Format Description Banner -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedTargetFormat.Description}" VerticalAlignment="Center" FontSize="12" Opacity="0.85"/>
                            <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorTertiaryBrush}" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="{Binding SelectedTargetFormat.Tag}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Step 3: Quality Settings & Action Card -->
            <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="10" Padding="16" Margin="0,0,0,14"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="3. Audio Quality &amp; Encoding Settings" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Quality Preset &amp; Bitrate:" VerticalAlignment="Center" FontWeight="Medium" Margin="0,0,12,0"/>

                        <ComboBox Grid.Column="1" ItemsSource="{Binding QualityOptions}" 
                                  SelectedItem="{Binding SelectedQuality}"
                                  DisplayMemberPath="DisplayText" Height="40" Margin="0,0,12,0"/>

                        <ui:Button Grid.Column="2" Content="Convert &amp; Save Audio" Icon="{ui:SymbolIcon Symbol=PlayCircle24}" 
                                   Appearance="Primary" Command="{Binding StartConversionCommand}" 
                                   IsEnabled="{Binding IsConverting, Converter={StaticResource InvBool}}" Height="40" Padding="22,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Status & Progress Banner -->
            <Border Grid.Row="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,14"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Symbol="Info24" Margin="0,0,10,0" VerticalAlignment="Center" 
                                   Visibility="{Binding HasError, Converter={StaticResource InvBoolToVis}}"/>

                    <ui:SymbolIcon Symbol="Warning24" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#E81123"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" 
                               FontWeight="Medium" TextTrimming="CharacterEllipsis"/>

                    <ui:ProgressRing Grid.Column="2" IsIndeterminate="True" Width="20" Height="20" Margin="10,0,0,0"
                                     Visibility="{Binding IsConverting, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <!-- Converted Audio Files Library & Action List -->
            <Border Grid.Row="5" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="10" Padding="18"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Library Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="MusicNote224" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Converted Audio Library" FontWeight="SemiBold" FontSize="16"/>
                        </StackPanel>

                        <ui:Button Grid.Column="1" Content="Open Music Folder" Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                   Command="{Binding OpenOutputFolderCommand}" Appearance="Primary" Height="36"/>
                    </Grid>

                    <!-- Items List -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ConvertedHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12,10" 
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Format Icon Badge -->
                                        <Border Grid.Column="0" Background="#20107C41" Width="44" Height="44" 
                                                CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="MusicNote224" FontSize="20" Foreground="#107C41"/>
                                        </Border>

                                        <!-- Item Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" 
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,3"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}" 
                                                        CornerRadius="4" Padding="6,1" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding SelectedQuality}" FontSize="11" FontWeight="Medium"/>
                                                </Border>
                                                <TextBlock Text="{Binding FormattedTime}" FontSize="11" Opacity="0.6"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Quick Actions (Play, Open Folder) -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#20107C41" BorderBrush="#40107C41" BorderThickness="1" 
                                                    CornerRadius="4" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="Ready" Foreground="#107C41" FontWeight="Bold" FontSize="11"/>
                                            </Border>

                                            <!-- Play Button -->
                                            <ui:Button Icon="{ui:SymbolIcon Symbol=Play24}" 
                                                       ToolTip="Play Audio"
                                                       Command="{Binding DataContext.PlayConvertedFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       Appearance="Secondary" Height="34" Width="36" Padding="0" Margin="0,0,6,0"/>

                                            <!-- Show in Folder Button -->
                                            <ui:Button Icon="{ui:SymbolIcon Symbol=FolderOpen24}" 
                                                       ToolTip="Show in File Explorer"
                                                       Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       Appearance="Secondary" Height="34" Width="36" Padding="0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

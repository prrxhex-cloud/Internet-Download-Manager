<UserControl x:Class="PRRX.IDM.Views.Tabs.IdmDownloadsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:PRRX.IDM.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="900">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:InverseBoolConverter x:Key="InvBool"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header with Status Badge -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="IDM Downloads &amp; Browser Module" FontSize="24" FontWeight="Bold"/>
                    <Border Background="#200078D4" BorderBrush="#400078D4" BorderThickness="1" 
                            CornerRadius="12" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="#0078D4" Margin="0,0,4,0"/>
                            <TextBlock Text="Chrome • Edge • Brave • Opera Bridge" FontSize="11" FontWeight="SemiBold" Foreground="#0078D4"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Dedicated repository for downloads initiated via the PRRX IDM Browser Extension and Floating Media Grabber." 
                           Opacity="0.75" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Extension Configuration & Diagnostics Card -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="10" Padding="16" Margin="0,0,0,16"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Browser Integration Bridge" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Intercepts all web downloads seamlessly and embeds floating media grabbers on video sites." 
                                       FontSize="12" Opacity="0.75" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#15107C41" BorderBrush="#30107C41" BorderThickness="1" 
                                CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PlugConnected24" Foreground="#107C41" Margin="0,0,6,0"/>
                                <TextBlock Text="Native Messaging IPC Port 6880" FontSize="11" FontWeight="SemiBold" Foreground="#107C41"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Status Banner -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#107C41" Margin="0,0,10,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsExtensionRegistered, Converter={StaticResource BoolToVis}}"/>
                            <ui:SymbolIcon Symbol="Warning24" Foreground="#D83B01" Margin="0,0,10,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsExtensionRegistered, Converter={StaticResource InvBoolToVis}}"/>

                            <TextBlock Grid.Column="1" Text="{Binding BrowserStatusMessage}" VerticalAlignment="Center" FontWeight="Medium" FontSize="12"/>

                            <ui:Button Grid.Column="2" Content="Check Bridge" Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                                       Appearance="Secondary" Command="{Binding RefreshStatusCommand}" Height="30" Padding="10,0"/>
                        </Grid>
                    </Border>

                    <!-- Action Controls Row -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:Button Grid.Column="0" Content="Register Browser Host" Icon="{ui:SymbolIcon Symbol=PlugConnected24}"
                                   Appearance="Primary" Command="{Binding RegisterBrowserHostCommand}" Height="36" Padding="14,0" Margin="0,0,10,0"/>

                        <ui:Button Grid.Column="1" Content="Open Extension Folder" Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                   Appearance="Secondary" Command="{Binding OpenExtensionFolderCommand}" Height="36" Padding="14,0"/>

                        <!-- Toggles -->
                        <CheckBox Grid.Column="3" Content="Auto-Intercept Downloads" IsChecked="{Binding EnableBrowserIntegration}"
                                  VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="Medium"/>

                        <CheckBox Grid.Column="4" Content="Floating Video Grabber" IsChecked="{Binding EnableFloatingPanel}"
                                  VerticalAlignment="Center" FontWeight="Medium"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- IDM Browser Downloads History Card -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="10" Padding="16"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Bar & Actions -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                                    PlaceholderText="Filter IDM browser downloads by filename or URL..." 
                                    Height="36" Margin="0,0,12,0"/>

                        <ui:Button Grid.Column="1" Content="Clear IDM History" Icon="{ui:SymbolIcon Symbol=Delete24}"
                                   Appearance="Secondary" Command="{Binding ClearBrowserDownloadsCommand}" Height="36"/>
                    </Grid>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40"
                                Visibility="{Binding BrowserDownloads.Count, Converter={StaticResource InvBoolToVis}}">
                        <Border Background="#100078D4" Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="30" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                        </Border>
                        <TextBlock Text="No IDM Browser Downloads Yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="When you download files or click the Floating Video Grabber in your browser, they will appear here automatically." 
                                   FontSize="12" Opacity="0.7" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- DataGrid of Browser Downloads -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding BrowserDownloads}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                              RowHeight="44" HeadersVisibility="Column" SelectionMode="Single"
                              MinHeight="250">
                        <DataGrid.Columns>
                            <!-- File Icon & Title -->
                            <DataGridTemplateColumn Header="File Name" Width="2.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <ui:SymbolIcon Symbol="Document24" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Size -->
                            <DataGridTextColumn Header="File Size" Binding="{Binding FileSizeFormatted}" Width="100"/>

                            <!-- Status -->
                            <DataGridTemplateColumn Header="Status" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#15107C41" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="#107C41"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Date / Time -->
                            <DataGridTextColumn Header="Downloaded At" Binding="{Binding FormattedTime}" Width="140"/>

                            <!-- Action Buttons -->
                            <DataGridTemplateColumn Header="Actions" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <ui:Button Icon="{ui:SymbolIcon Symbol=Play24}" Height="28" Width="28" Margin="0,0,4,0"
                                                       Command="{Binding DataContext.PlayFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding}" ToolTip="Open Downloaded File"/>
                                            <ui:Button Icon="{ui:SymbolIcon Symbol=FolderOpen24}" Height="28" Width="28" Margin="0,0,4,0"
                                                       Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding}" ToolTip="Open Containing Folder"/>
                                            <ui:Button Icon="{ui:SymbolIcon Symbol=Delete24}" Height="28" Width="28"
                                                       Command="{Binding DataContext.DeleteHistoryItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding}" ToolTip="Remove From History"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

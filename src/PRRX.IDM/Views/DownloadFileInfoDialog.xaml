<Window x:Class="PRRX.IDM.Views.DownloadFileInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Download File Info - PRRX IDM" 
        Height="420" Width="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#121620" 
            BorderBrush="#2A344A" 
            BorderThickness="1" 
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="8" Opacity="0.6"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title bar -->
                <RowDefinition Height="*"/>    <!-- Content fields -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,18" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="#1E2738" Margin="0,0,10,0">
                        <TextBlock Text="📥" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Download File Info" FontSize="16" FontWeight="SemiBold" Foreground="#F0F4F8" VerticalAlignment="Center"/>
                    <TextBlock Text=" • PRRX Accelerated" FontSize="12" Foreground="#00E5FF" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right"
                        Background="Transparent" Foreground="#8A9BB4" BorderThickness="0"
                        FontSize="13" Cursor="Hand" Click="Close_Click"/>
            </Grid>

            <!-- 2. Form Body -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- URL -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="URL:" Foreground="#8A9BB4" VerticalAlignment="Center" Margin="0,0,0,12"/>
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Url, Mode=OneWay}" IsReadOnly="True"
                         Background="#181F2E" Foreground="#E2E8F0" BorderBrush="#2A344A" BorderThickness="1"
                         Padding="10,6" Margin="0,0,0,12" FontSize="12"/>

                <!-- Category -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Category:" Foreground="#8A9BB4" VerticalAlignment="Center" Margin="0,0,0,12"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedCategory}"
                          Background="#181F2E" Foreground="#FFFFFF" BorderBrush="#2A344A"
                          Padding="8,6" Margin="0,0,10,12" FontSize="12"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding FileSizeFormatted}" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,0,12" FontWeight="SemiBold"/>

                <!-- Save As -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Save To:" Foreground="#8A9BB4" VerticalAlignment="Center" Margin="0,0,0,12"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SaveAsFullPath, Mode=OneWay}" IsReadOnly="True"
                         Background="#181F2E" Foreground="#E2E8F0" BorderBrush="#2A344A" BorderThickness="1"
                         Padding="10,6" Margin="0,0,10,12" FontSize="12"/>
                <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Command="{Binding BrowseDirectoryCommand}"
                        Background="#202A3D" Foreground="#F0F4F8" BorderBrush="#354460" BorderThickness="1"
                        Padding="14,6" Margin="0,0,0,12" Cursor="Hand"/>

                <!-- Description -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Description:" Foreground="#8A9BB4" VerticalAlignment="Top" Margin="0,6,0,0"/>
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Background="#181F2E" Foreground="#E2E8F0" BorderBrush="#2A344A" BorderThickness="1"
                         Padding="10,6" Height="65" TextWrapping="Wrap" AcceptsReturn="True" FontSize="12"/>
            </Grid>

            <!-- 3. Bottom Actions -->
            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Download Later" Command="{Binding DownloadLaterCommand}"
                            Background="#1E2738" Foreground="#A0AEC0" BorderBrush="#2E3B52" BorderThickness="1"
                            Padding="16,8" Margin="0,0,10,0" Cursor="Hand" FontWeight="Medium"/>

                    <Button Content="⚡ Start Download" Command="{Binding StartDownloadCommand}"
                            Background="#00A2FF" Foreground="#FFFFFF" BorderThickness="0"
                            Padding="20,8" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#00C4FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                            Background="#181F2E" Foreground="#8A9BB4" BorderBrush="#2A344A" BorderThickness="1"
                            Padding="16,8" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

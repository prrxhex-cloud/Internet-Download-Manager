<Window x:Class="PRRX.IDM.Views.DownloadFileInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PRRX IDM Module" 
        Height="440" Width="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/Assets/app_icon.png"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="#1C202B" 
            BorderBrush="#25FFFFFF" 
            BorderThickness="1" 
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="10" Opacity="0.55"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title bar -->
                <RowDefinition Height="*"/>    <!-- Content fields -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,20" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#242B3A" Margin="0,0,12,0" VerticalAlignment="Center" ClipToBounds="True"
                            BorderBrush="#20FFFFFF" BorderThickness="1">
                        <Image Source="pack://application:,,,/Assets/app_icon.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PRRX IDM — Download Task" FontSize="15" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <Border Background="#200078D4" BorderBrush="#400078D4" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="High Priority" FontSize="10" FontWeight="SemiBold" Foreground="#0078D4"/>
                            </Border>

                            <!-- Global Community Intelligence Security Badge -->
                            <Border Background="{Binding SecurityBadgeBgColor}" 
                                    BorderBrush="{Binding SecurityBadgeBorderColor}" 
                                    BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                    ToolTip="{Binding SecurityBadgeTooltip}">
                                <TextBlock Text="{Binding SecurityBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding SecurityBadgeFgColor}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="#8FA0B8" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="480"/>
                    </StackPanel>
                </StackPanel>

                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right"
                        Background="Transparent" Foreground="#8FA0B8" BorderThickness="0"
                        FontSize="13" Cursor="Hand" Click="Close_Click"/>
            </Grid>

            <!-- 2. Form Body -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- URL -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="URL:" Foreground="#8FA0B8" VerticalAlignment="Center" Margin="0,0,0,12" FontWeight="Medium" FontSize="12"/>
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Url, Mode=OneWay}" IsReadOnly="True"
                         Background="#161922" Foreground="#E2E8F0" BorderBrush="#2A3245" BorderThickness="1"
                         Padding="10,6" Margin="0,0,0,12" FontSize="12"/>

                <!-- Category -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Category:" Foreground="#8FA0B8" VerticalAlignment="Center" Margin="0,0,0,12" FontWeight="Medium" FontSize="12"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedCategory}"
                          Background="#161922" Foreground="#FFFFFF" BorderBrush="#2A3245"
                          Padding="8,6" Margin="0,0,10,12" FontSize="12"/>
                
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="{Binding FileSizeFormatted}" Foreground="#0078D4" VerticalAlignment="Center" FontWeight="Bold" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProbing}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="ProbingPulseStoryboard">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.35" Duration="0:0:0.6"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="ProbingPulseStoryboard"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Cloud Acceleration & Domain Speed Badge -->
                    <Border Visibility="{Binding HasDomainSpeedInfo, Converter={StaticResource BoolToVis}}"
                            Background="#1500C853" BorderBrush="#3500C853" BorderThickness="1" CornerRadius="4" 
                            Padding="5,2" Margin="8,0,0,0" VerticalAlignment="Center"
                            ToolTip="{Binding DomainHealthSummary}">
                        <TextBlock Text="{Binding DomainSpeedFormatted}" FontSize="10" FontWeight="SemiBold" Foreground="#4ADE80"/>
                    </Border>
                </StackPanel>

                <!-- Save As -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Save To:" Foreground="#8FA0B8" VerticalAlignment="Center" Margin="0,0,0,12" FontWeight="Medium" FontSize="12"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SaveAsFullPath, Mode=OneWay}" IsReadOnly="True"
                         Background="#161922" Foreground="#E2E8F0" BorderBrush="#2A3245" BorderThickness="1"
                         Padding="10,6" Margin="0,0,10,12" FontSize="12"/>
                <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Command="{Binding BrowseDirectoryCommand}"
                        Background="#222836" Foreground="#F0F4F8" BorderBrush="#333D52" BorderThickness="1"
                        Padding="14,6" Margin="0,0,0,12" Cursor="Hand" FontWeight="Medium"/>

                <!-- Description -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Description:" Foreground="#8FA0B8" VerticalAlignment="Top" Margin="0,6,0,0" FontWeight="Medium" FontSize="12"/>
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Background="#161922" Foreground="#E2E8F0" BorderBrush="#2A3245" BorderThickness="1"
                         Padding="10,6" Height="65" TextWrapping="Wrap" AcceptsReturn="True" FontSize="12"/>
            </Grid>

            <!-- 3. Bottom Actions -->
            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <!-- Community Reputation Voting -->
                    <TextBlock Text="Community Security:" Foreground="#8FA0B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Content="✓ Safe" Command="{Binding VoteSafeCommand}" IsEnabled="{Binding CanVote}"
                            Background="#18107C41" Foreground="#4ADE80" BorderBrush="#35107C41" BorderThickness="1"
                            Padding="7,3" Margin="0,0,4,0" Cursor="Hand" FontSize="10" FontWeight="SemiBold"
                            ToolTip="Verify and vote this download as safe in the community database"/>
                    <Button Content="⚠ Report" Command="{Binding VoteSuspiciousCommand}" IsEnabled="{Binding CanVote}"
                            Background="#20E81123" Foreground="#F87171" BorderBrush="#40E81123" BorderThickness="1"
                            Padding="7,3" Margin="0,0,8,0" Cursor="Hand" FontSize="10" FontWeight="SemiBold"
                            ToolTip="Report this file as suspicious/malware to the community threat intelligence network"/>
                    <TextBlock Text="{Binding VoteFeedbackText}" Foreground="{Binding VoteFeedbackFgColor}" FontSize="10" FontWeight="Medium" 
                               VerticalAlignment="Center" Visibility="{Binding HasVoteFeedback, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Download Later" Command="{Binding DownloadLaterCommand}"
                            Background="#222836" Foreground="#A0AEC0" BorderBrush="#333D52" BorderThickness="1"
                            Padding="16,9" Margin="0,0,10,0" Cursor="Hand" FontWeight="Medium"/>

                    <Button Content="Start Download" Command="{Binding StartDownloadCommand}"
                            Background="#0078D4" Foreground="#FFFFFF" BorderThickness="0"
                            Padding="22,9" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold"/>

                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                            Background="#222836" Foreground="#8FA0B8" BorderBrush="#333D52" BorderThickness="1"
                            Padding="16,9" Cursor="Hand" FontWeight="Medium"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="PRRX.IDM.Views.BatchDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Download All Links with PRRX IDM" 
        Height="540" Width="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/Assets/app_icon.png"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="5">
                            <Path x:Name="IconPath" Data="M 0,0 L 9,9 M 0,9 L 9,0" Stroke="#8FA0B8" StrokeThickness="1.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#E81123"/>
                                <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#C42B1C"/>
                                <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1C202B" 
            BorderBrush="#25FFFFFF" 
            BorderThickness="1" 
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="10" Opacity="0.55"/>
        </Border.Effect>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Filter & Actions -->
                <RowDefinition Height="*"/>    <!-- DataGrid -->
                <RowDefinition Height="Auto"/> <!-- Save Directory & Bottom Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Background="#242B3A" Margin="0,0,10,0" ClipToBounds="True"
                            BorderBrush="#20FFFFFF" BorderThickness="1">
                        <Image Source="pack://application:,,,/Assets/app_icon.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Download All Links — PRRX IDM" FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SourcePageTitle, StringFormat=' — {0}'}" FontSize="12" Foreground="#8FA0B8" 
                               MaxWidth="400" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <Button Style="{StaticResource CaptionCloseButtonStyle}" HorizontalAlignment="Right"
                        ToolTip="Close" Click="Close_Click"/>
            </Grid>

            <!-- 2. Filter & Selection Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Check All" Command="{Binding CheckAllCommand}"
                            Background="#222836" Foreground="#E2E8F0" BorderBrush="#333D52" BorderThickness="1"
                            Padding="14,6" Margin="0,0,8,0" Cursor="Hand" FontSize="11" FontWeight="Medium"/>
                    <Button Content="Uncheck All" Command="{Binding UncheckAllCommand}"
                            Background="#222836" Foreground="#A0AEC0" BorderBrush="#333D52" BorderThickness="1"
                            Padding="14,6" Margin="0,0,16,0" Cursor="Hand" FontSize="11" FontWeight="Medium"/>

                    <TextBlock Text="Filter:" Foreground="#8FA0B8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="Medium"/>
                    <TextBox Text="{Binding FilterQuery, UpdateSourceTrigger=PropertyChanged}" Width="180"
                             Background="#161922" Foreground="#E2E8F0" BorderBrush="#2A3245" BorderThickness="1"
                             Padding="10,5" FontSize="11"/>
                </StackPanel>
            </Grid>

            <!-- 3. Links DataGrid -->
            <Border Grid.Row="2" Background="#161922" BorderBrush="#252E40" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                <DataGrid ItemsSource="{Binding Links}" AutoGenerateColumns="False"
                          Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                          RowBackground="#161922" AlternatingRowBackground="#1A1E29"
                          Foreground="#E2E8F0" GridLinesVisibility="None"
                          CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1F2533"/>
                            <Setter Property="Foreground" Value="#8FA0B8"/>
                            <Setter Property="Padding" Value="10,7"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="BorderBrush" Value="#252E40"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="35"/>
                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="220" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="95" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding FileSizeFormatted}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Download URL" Binding="{Binding Url}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 4. Save Directory & Action Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Save To:" Foreground="#8FA0B8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="Medium"/>
                    <TextBox Text="{Binding SaveDirectory, Mode=OneWay}" IsReadOnly="True" Width="300"
                             Background="#161922" Foreground="#E2E8F0" BorderBrush="#2A3245" BorderThickness="1"
                             Padding="10,6" Margin="0,0,8,0" FontSize="11"/>
                    <Button Content="Browse..." Command="{Binding BrowseDirectoryCommand}"
                            Background="#222836" Foreground="#E2E8F0" BorderBrush="#333D52" BorderThickness="1"
                            Padding="14,6" Cursor="Hand" FontSize="11" FontWeight="Medium"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Start Batch Download" Command="{Binding StartBatchDownloadCommand}"
                            Background="#0078D4" Foreground="#FFFFFF" BorderThickness="0"
                            Padding="20,9" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold"/>

                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                            Background="#222836" Foreground="#8FA0B8" BorderBrush="#333D52" BorderThickness="1"
                            Padding="18,9" Cursor="Hand" FontWeight="Medium"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

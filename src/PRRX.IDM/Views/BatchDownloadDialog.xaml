<Window x:Class="PRRX.IDM.Views.BatchDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Download All Links with PRRX IDM" 
        Height="540" Width="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/Assets/app_icon.png"
        ResizeMode="CanResizeWithGrip">

    <Border Background="#10141D" 
            BorderBrush="#252F42" 
            BorderThickness="1" 
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="8" Opacity="0.6"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Filter & Actions -->
                <RowDefinition Height="*"/>    <!-- DataGrid -->
                <RowDefinition Height="Auto"/> <!-- Save Directory & Bottom Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,14" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="5" Background="#1A2233" Margin="0,0,8,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/app_icon.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Download All Links with PRRX IDM" FontSize="15" FontWeight="SemiBold" Foreground="#F0F4F8" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SourcePageTitle, StringFormat=' ({0})'}" FontSize="12" Foreground="#8A9BB4" 
                               MaxWidth="380" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right"
                        Background="Transparent" Foreground="#8A9BB4" BorderThickness="0"
                        FontSize="12" Cursor="Hand" Click="Close_Click"/>
            </Grid>

            <!-- 2. Filter & Selection Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Check All" Command="{Binding CheckAllCommand}"
                            Background="#1A2233" Foreground="#E2E8F0" BorderBrush="#2A344A" BorderThickness="1"
                            Padding="12,5" Margin="0,0,8,0" Cursor="Hand" FontSize="11"/>
                    <Button Content="Uncheck All" Command="{Binding UncheckAllCommand}"
                            Background="#1A2233" Foreground="#A0AEC0" BorderBrush="#2A344A" BorderThickness="1"
                            Padding="12,5" Margin="0,0,14,0" Cursor="Hand" FontSize="11"/>

                    <TextBlock Text="Filter:" Foreground="#8A9BB4" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                    <TextBox Text="{Binding FilterQuery, UpdateSourceTrigger=PropertyChanged}" Width="160"
                             Background="#151B27" Foreground="#E2E8F0" BorderBrush="#252F42" BorderThickness="1"
                             Padding="8,4" FontSize="11"/>
                </StackPanel>
            </Grid>

            <!-- 3. Links DataGrid -->
            <Border Grid.Row="2" Background="#121722" BorderBrush="#222C3E" BorderThickness="1" CornerRadius="6" Margin="0,0,0,14">
                <DataGrid ItemsSource="{Binding Links}" AutoGenerateColumns="False"
                          Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                          RowBackground="#121722" AlternatingRowBackground="#151B27"
                          Foreground="#E2E8F0" GridLinesVisibility="None"
                          CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#171E2B"/>
                            <Setter Property="Foreground" Value="#8A9BB4"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="BorderBrush" Value="#222C3E"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="35"/>
                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="200" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding FileSizeFormatted}" Width="85" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Download URL" Binding="{Binding Url}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 4. Save Directory & Action Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Save To:" Foreground="#8A9BB4" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                    <TextBox Text="{Binding SaveDirectory, Mode=OneWay}" IsReadOnly="True" Width="280"
                             Background="#151B27" Foreground="#E2E8F0" BorderBrush="#252F42" BorderThickness="1"
                             Padding="8,5" Margin="0,0,8,0" FontSize="11"/>
                    <Button Content="Browse..." Command="{Binding BrowseDirectoryCommand}"
                            Background="#1E2738" Foreground="#E2E8F0" BorderBrush="#2A354A" BorderThickness="1"
                            Padding="12,5" Cursor="Hand" FontSize="11"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="⚡ Start Batch Download" Command="{Binding StartBatchDownloadCommand}"
                            Background="#00A2FF" Foreground="#FFFFFF" BorderThickness="0"
                            Padding="18,8" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold"/>

                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                            Background="#181F2E" Foreground="#8A9BB4" BorderBrush="#263144" BorderThickness="1"
                            Padding="16,8" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

<ui:FluentWindow x:Class="PRRX.IDM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:PRRX.IDM.ViewModels"
        xmlns:tabs="clr-namespace:PRRX.IDM.Views.Tabs"
        mc:Ignorable="d"
        Title="PRRX Internet Download Manager" 
        Height="740" Width="1080"
        MinHeight="640" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        Icon="/Assets/app_icon.png"
        ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:VideoDownloaderViewModel}">
            <tabs:VideoDownloaderTab/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AudioConverterViewModel}">
            <tabs:AudioConverterTab/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ThumbnailViewModel}">
            <tabs:ThumbnailTab/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <tabs:SettingsTab/>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation (Liquid Glass Style) -->
        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="14,36,14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header with Custom App Icon -->
                <StackPanel Grid.Row="0" Margin="8,0,8,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="8" ClipToBounds="True" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/app_icon.png" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PRRX IDM" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Internet Download Manager" FontSize="10" Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Buttons (One Feature per Tab) -->
                <StackPanel Grid.Row="1">
                    <ui:Button Content="Video Downloader" Icon="{ui:SymbolIcon Symbol=Video24}"
                               Command="{Binding NavigateTabCommand}" CommandParameter="Video"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Height="44" Margin="0,0,0,6" Padding="14,0"/>

                    <ui:Button Content="Audio Converter" Icon="{ui:SymbolIcon Symbol=MusicNote224}"
                               Command="{Binding NavigateTabCommand}" CommandParameter="Audio"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Height="44" Margin="0,0,0,6" Padding="14,0"/>

                    <ui:Button Content="Thumbnail Grabber" Icon="{ui:SymbolIcon Symbol=ImageSearch24}"
                               Command="{Binding NavigateTabCommand}" CommandParameter="Thumbnail"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Height="44" Margin="0,0,0,6" Padding="14,0"/>
                </StackPanel>

                <!-- Bottom Settings Nav -->
                <StackPanel Grid.Row="2">
                    <ui:Button Content="Settings &amp; Updates" Icon="{ui:SymbolIcon Symbol=Settings24}"
                               Command="{Binding NavigateTabCommand}" CommandParameter="Settings"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Height="44" Padding="14,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area with Liquid Glass Effect -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Fluent Titlebar -->
            <ui:TitleBar Grid.Row="0" Title="PRRX Internet Download Manager" Icon="pack://application:,,,/Assets/app_icon.png"/>

            <!-- Active Feature Tab View with Smooth Content Transition -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentTabViewModel}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.4" To="1.0" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>
    </Grid>
</ui:FluentWindow>

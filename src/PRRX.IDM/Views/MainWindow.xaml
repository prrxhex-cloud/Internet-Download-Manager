<ui:FluentWindow x:Class="PRRX.IDM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:PRRX.IDM.ViewModels"
        xmlns:tabs="clr-namespace:PRRX.IDM.Views.Tabs"
        mc:Ignorable="d"
        Title="PRRX Internet Download Manager" 
        Height="760" Width="1100"
        MinHeight="660" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        Icon="/Assets/app_icon.png"
        ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:VideoDownloaderViewModel}">
            <tabs:VideoDownloaderTab/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AudioConverterViewModel}">
            <tabs:AudioConverterTab/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ThumbnailViewModel}">
            <tabs:ThumbnailTab/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <tabs:SettingsTab/>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation (Windows 11 Fluent 2 Acrylic Style) -->
        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,36,16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header with Custom App Icon & Enterprise Watermark -->
                <StackPanel Grid.Row="0" Margin="6,0,6,28">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="10" ClipToBounds="True" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Image Source="pack://application:,,,/Assets/app_icon.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PRRX IDM™" FontSize="19" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            <TextBlock Text="Enterprise Download Manager" FontSize="11" Opacity="0.65"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Buttons (Fluent 2 Micro-interactions & Clear Icons) -->
                <StackPanel Grid.Row="1">
                    <ui:Button Content="Video Downloader" Icon="{ui:SymbolIcon Symbol=Video24}"
                               Command="{Binding NavigateTabCommand}" CommandParameter="Video"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Height="44" Margin="0,0,0,8" Padding="16,0" CornerRadius="8"/>

                    <ui:Button Content="Audio Converter" Icon="{ui:SymbolIcon Symbol=MusicNote224}"
                               Command="{Binding NavigateTabCommand}" CommandParameter="Audio"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Height="44" Margin="0,0,0,8" Padding="16,0" CornerRadius="8"/>

                    <ui:Button Content="Thumbnail Grabber" Icon="{ui:SymbolIcon Symbol=ImageSearch24}"
                               Command="{Binding NavigateTabCommand}" CommandParameter="Thumbnail"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Height="44" Margin="0,0,0,8" Padding="16,0" CornerRadius="8"/>
                </StackPanel>

                <!-- Bottom Settings Nav & Security Badge -->
                <StackPanel Grid.Row="2">
                    <Border Background="#10107C41" BorderBrush="#30107C41" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldCheckmark20" Foreground="#107C41" Margin="0,0,8,0"/>
                            <TextBlock Text="E2E Vault Active" FontSize="11" FontWeight="SemiBold" Foreground="#107C41" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ui:Button Content="Settings &amp; Updates" Icon="{ui:SymbolIcon Symbol=Settings24}"
                               Command="{Binding NavigateTabCommand}" CommandParameter="Settings"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Height="44" Padding="16,0" CornerRadius="8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area with Liquid Glass Effect -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Fluent Titlebar -->
            <ui:TitleBar Grid.Row="0" Title="PRRX Internet Download Manager — Secure Enterprise Edition" Icon="pack://application:,,,/Assets/app_icon.png"/>

            <!-- Active Feature Tab View with Smooth Content Transition -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentTabViewModel}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.4" To="1.0" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>
    </Grid>
</ui:FluentWindow>

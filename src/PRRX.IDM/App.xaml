<Application x:Class="PRRX.IDM.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:PRRX.IDM.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ControlsDictionary />
                <ui:ThemesDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Fluid Smooth ScrollViewer Style -->
            <Style TargetType="ScrollViewer">
                <Setter Property="controls:SmoothScroll.IsEnabled" Value="True"/>
                <Setter Property="PanningMode" Value="Both"/>
                <Setter Property="IsDeferredScrollingEnabled" Value="False"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
